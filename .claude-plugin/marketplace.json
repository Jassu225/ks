{
  "name": "karmasuite",
  "owner": {
    "name": "Jaswanth Sai Sattenapalli"
  },
  "metadata": {
    "description": "KarmaSuite development plugins"
  },
  "plugins": [
    {
      "name": "ks",
      "source": "./plugins/ks",
      "description": "KarmaSuite development tools and workflows",
      "version": "1.0.0",
      "author": {
        "name": "Jaswanth Sai Sattenapalli"
      },
      "repository": "https://github.com/karmasuite/ks",
      "keywords": ["karmasuite", "linear", "workflow", "project-management"]
    },
    {
      "name": "ks-flow",
      "source": "./plugins/ks-flow",
      "description": "Per-project Kanban board over your Claude Code sessions, with macOS notifications when a session blocks waiting for you",
      "version": "0.1.0",
      "author": {
        "name": "Jaswanth Sai Sattenapalli"
      },
      "repository": "https://github.com/karmasuite/ks",
      "keywords": ["claude-code", "kanban", "sessions", "notifications", "firestore"]
    },
    {
      "name": "ks-agent-limit",
      "source": "./plugins/ks-agent-limit",
      "description": "Caps how many Claude sessions and agents run at once on this machine; a spawn past the limit is refused and reported",
      "version": "0.1.0",
      "author": {
        "name": "Jaswanth Sai Sattenapalli"
      },
      "repository": "https://github.com/karmasuite/ks",
      "keywords": ["claude-code", "agents", "concurrency", "limit"]
    },
    {
      "name": "ks-master",
      "source": "./plugins/ks-master",
      "description": "The ks-flow master session: reads Slack into the Briefing board on a schedule, runs log-in and log-off, and wakes itself on requests from the ks-flow daemon and board",
      "version": "0.1.0",
      "author": {
        "name": "Jaswanth Sai Sattenapalli"
      },
      "repository": "https://github.com/karmasuite/ks",
      "keywords": ["claude-code", "slack", "briefing", "ks-flow"]
    }
  ]
}
