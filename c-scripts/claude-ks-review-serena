#!/bin/bash
# Launch Claude Code with ks plugin, Serena MCP (session-only), and code-review plugin
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Get code-review plugin directory (latest version by lastUpdated)
INSTALLED_PLUGINS="$HOME/.claude/plugins/installed_plugins.json"
if [ ! -f "$INSTALLED_PLUGINS" ]; then
  echo "Error: $INSTALLED_PLUGINS not found. Install the code-review plugin first:"
  echo "  claude plugin install code-review@claude-plugins-official"
  exit 1
fi

CODE_REVIEW_DIR=$(jq -r '
  .plugins["code-review@claude-plugins-official"]
  | sort_by(.lastUpdated)
  | last
  | .installPath
' "$INSTALLED_PLUGINS")

if [ -z "$CODE_REVIEW_DIR" ] || [ "$CODE_REVIEW_DIR" = "null" ]; then
  echo "Error: code-review@claude-plugins-official not found in installed plugins."
  echo "Install it first:"
  echo "  claude plugin install code-review@claude-plugins-official"
  exit 1
fi

if [ ! -d "$CODE_REVIEW_DIR" ]; then
  echo "Error: Code review plugin directory not found at $CODE_REVIEW_DIR"
  echo "Reinstall the plugin:"
  echo "  claude plugin install code-review@claude-plugins-official"
  exit 1
fi

exec "$SCRIPT_DIR/claude-ks-serena" --plugin-dir "$CODE_REVIEW_DIR" "$@"
