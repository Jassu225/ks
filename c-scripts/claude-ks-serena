#!/bin/bash
# Launch Claude Code with ks plugin, Serena MCP (session-only)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

SERENA_CONFIG='{"mcpServers":{"serena":{"command":"uvx","args":["--from","git+https://github.com/oraios/serena","serena","start-mcp-server","--context=claude-code","--project-from-cwd"]}}}'

exec "$SCRIPT_DIR/claude-ks" --mcp-config "$SERENA_CONFIG" "$@"
