rules_version = '2';

// ks-flow security model:
//   - Every ks-flow read and write uses the Admin SDK (daemon, CLIs, and the
//     board's own server, which streams to the browser via /api/store/live).
//     The Admin SDK BYPASSES these rules.
//   - The browser never talks to Firestore, so clients get nothing.
//
// Deny all, for every client: no reads, no writes. This is what is live on
// project `ks-flow`'s (default) database (verified 2026-11-16, ruleset
// 7221e767-…). The database is shared with ks-works (`slack_user_tokens`),
// which also uses only the Admin SDK, so neither app needs a client rule.
// `firebase deploy --only firestore:rules --project ks-flow` replaces the
// WHOLE database's ruleset: only ever deploy this deny-all, and never add an
// `allow` that is not `if false`. Also used by the local emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
