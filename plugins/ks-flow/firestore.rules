rules_version = '2';

// ks-flow security model:
//   - Every ks-flow read and write uses the Admin SDK (daemon, CLIs, and the
//     board's own server, which streams to the browser via /api/store/live).
//     The Admin SDK BYPASSES these rules.
//   - The browser never talks to Firestore, so clients get nothing.
//
// DO NOT DEPLOY this file to project `ks-flow` as it stands: its (default)
// database is shared with ks-works (`slack_user_tokens`), and
// `firebase deploy --only firestore:rules` replaces the WHOLE database's
// ruleset. It is kept for the local emulator, and as the intended client
// policy: deny all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
