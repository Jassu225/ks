#!/bin/bash
# ks-flow — CLI on PATH while the plugin is enabled.
#
#   ks-flow start             start the daemon (+ PocketBase); builds/installs on first run
#   ks-flow open              build and open the board UI in the browser
#   ks-flow close             stop the board UI server
#   ks-flow stop              stop everything — board UI, daemon, and PocketBase
#   ks-flow status            print daemon + ingestion status
#   ks-flow daemon            run the ingester in the foreground (debug)
#   ks-flow set-project PATH  re-point the tracked project (rewrites project.conf)
#   ks-flow archive PATH      archive one worktree's transcript+workflow to GCS
#   ks-flow backfill-archive  archive all completed (worktree-removed) workflows
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Derive the data dir the SAME way as hooks/daemon/board (src/lib/datadir.mjs):
# from the project's git-common-dir, so it's independent of the load method.
# Resolution order:
#   1. KS_FLOW_DATA / project_path env  → explicit
#   2. cwd is inside a configured project (its derived dir has project.conf)
#   3. exactly ONE configured project exists anywhere → use it (run-from-anywhere)
#   4. else cwd-derived (best effort); warn if it's ambiguous (multiple configured)
DATA_ROOT="$HOME/.claude/plugins/data/ks-flow"

# Collect every data dir that already has a project.conf.
CONFIGURED=()
if [ -d "$DATA_ROOT" ]; then
  for d in "$DATA_ROOT"/*/; do
    [ -f "${d}project.conf" ] && CONFIGURED+=("${d%/}")
  done
fi

if [ -n "${KS_FLOW_DATA:-}" ]; then
  DATA_DIR="$KS_FLOW_DATA"
elif [ -n "${CLAUDE_PLUGIN_OPTION_project_path:-}" ]; then
  DATA_DIR="$(node "$PLUGIN_ROOT/src/lib/datadir.mjs" --project "${CLAUDE_PLUGIN_OPTION_project_path/#\~/$HOME}")"
else
  CWD_DIR="$(node "$PLUGIN_ROOT/src/lib/datadir.mjs" --cwd "$PWD")"
  if [ -f "$CWD_DIR/project.conf" ]; then
    DATA_DIR="$CWD_DIR"                      # cwd is inside a configured project
  elif [ "${#CONFIGURED[@]}" -eq 1 ]; then
    DATA_DIR="${CONFIGURED[0]}"              # exactly one configured → use it anywhere
  elif [ "${#CONFIGURED[@]}" -gt 1 ]; then
    DATA_DIR="$CWD_DIR"
    echo "ks-flow: multiple configured projects under $DATA_ROOT — using cwd's. Set CLAUDE_PLUGIN_OPTION_project_path or cd into the repo to pick one." >&2
  else
    DATA_DIR="$CWD_DIR"                      # none configured yet (fresh setup)
  fi
fi
[ -n "$DATA_DIR" ] || DATA_DIR="${CLAUDE_PLUGIN_DATA:-$HOME/.claude/plugins/data/ks-flow-karmasuite}"
# Hand the resolved dir to every child. Without this, node entrypoints re-derive
# it from the CWD (src/lib/datadir.mjs), so running `ks-flow backup` from another
# repo silently read a data dir with no board-settings.json and reported "GCS
# archive is disabled" — the resolution above, including the "exactly one
# configured project" fallback, applied only to this shell script.
export KS_FLOW_DATA="$DATA_DIR"
DAEMON_DIR="$DATA_DIR/daemon"
LABEL="com.ksflow.ingester"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
UID_NUM="$(id -u)"
BOARD_PORT="${CLAUDE_PLUGIN_OPTION_board_port:-4317}"
PB_PORT="${CLAUDE_PLUGIN_OPTION_pocketbase_port:-8090}"

cmd="${1:-status}"
case "$cmd" in
  open)
    WEB="$DATA_DIR/web"
    # Rebuild when missing OR when the bundled board source changed — otherwise
    # `open` would keep serving a stale build (the bug that shipped old UI).
    NEED_BUILD=0
    if [ ! -d "$WEB/node_modules" ] || [ ! -d "$WEB/.next" ]; then
      NEED_BUILD=1
    else
      for d in app components lib; do
        diff -qr "$PLUGIN_ROOT/web/$d" "$WEB/$d" >/dev/null 2>&1 || NEED_BUILD=1
      done
      for f in package.json tailwind.config.ts postcss.config.js next.config.js globals.css; do
        [ "$f" = "globals.css" ] && continue  # lives under app/, already diffed
        diff -q "$PLUGIN_ROOT/web/$f" "$WEB/$f" >/dev/null 2>&1 || NEED_BUILD=1
      done
    fi

    if [ "$NEED_BUILD" = "1" ]; then
      echo "Building board…" >&2
      mkdir -p "$WEB"
      # Sync source over the deployed copy (node_modules + .next are preserved;
      # they live only in $WEB, never in the bundled source).
      cp -R "$PLUGIN_ROOT/web/." "$WEB/"
      ( cd "$WEB" && npm install --no-audit --no-fund --cache "$DATA_DIR/.npm" && npm run build )
    fi

    echo "Board → http://localhost:$BOARD_PORT" >&2
    # Export the plugin root so the board's /api/project route can run bootstrap,
    # and pin CLAUDE_PLUGIN_DATA to the derived dir so the board's Node resolves
    # the same data dir as the daemon/hooks (it has no cwd to derive from).
    ( cd "$WEB" && KS_FLOW_PLUGIN_ROOT="$PLUGIN_ROOT" CLAUDE_PLUGIN_DATA="$DATA_DIR" PORT="$BOARD_PORT" npm run start >"$DATA_DIR/board.log" 2>&1 & )
    # Wait until the server actually answers before opening the browser, so it
    # doesn't hit connection-refused on a slow start.
    URL="http://localhost:$BOARD_PORT"
    for _ in $(seq 1 30); do
      curl -fsS -o /dev/null "$URL" 2>/dev/null && break
      sleep 0.5
    done
    echo "Opening $URL in your browser…" >&2
    open "$URL" 2>/dev/null || echo "Could not auto-open — visit $URL" >&2
    ;;

  start)
    # Start (or refresh) the daemon — bootstrap installs/builds on first run,
    # downloads PocketBase, and loads the always-on launchd agent that spawns it.
    #
    # bootstrap needs project_path; inside a Claude session it's in the env, but
    # from a plain shell it isn't — fall back to the persisted project.conf so
    # `ks-flow start` works standalone.
    if [ -z "${CLAUDE_PLUGIN_OPTION_project_path:-}" ] && [ -f "$DATA_DIR/project.conf" ]; then
      CLAUDE_PLUGIN_OPTION_project_path="$(jq -r '.projectPath // empty' "$DATA_DIR/project.conf")"
      export CLAUDE_PLUGIN_OPTION_project_path
    fi
    # Last resort: running from inside a git repo configures that repo.
    if [ -z "${CLAUDE_PLUGIN_OPTION_project_path:-}" ] && git -C "$PWD" rev-parse --git-dir >/dev/null 2>&1; then
      CLAUDE_PLUGIN_OPTION_project_path="$PWD"
      export CLAUDE_PLUGIN_OPTION_project_path
    fi
    if [ -z "${CLAUDE_PLUGIN_OPTION_project_path:-}" ]; then
      echo "no project configured — run 'ks-flow set-project <path>' or set it on the board's settings page." >&2
      exit 1
    fi

    echo "starting daemon (project: $CLAUDE_PLUGIN_OPTION_project_path)…"
    "$PLUGIN_ROOT/scripts/bootstrap.sh"
    sleep 1

    echo "daemon (launchd):"
    if launchctl print "gui/$UID_NUM/$LABEL" >/dev/null 2>&1; then
      launchctl print "gui/$UID_NUM/$LABEL" | grep -E 'state =|pid =' | sed 's/^/  /'
    else
      echo "  not loaded — see $DATA_DIR/daemon.err.log"
    fi
    if [ -f "$DATA_DIR/daemon.log" ]; then
      echo "recent daemon log ($DATA_DIR/daemon.log):"
      tail -n 12 "$DATA_DIR/daemon.log" | sed 's/^/  /'
    fi
    echo "board: 'ks-flow open'   ·   status: 'ks-flow status'"
    ;;

  close)
    # Stop only the board UI server (whatever is listening on BOARD_PORT).
    PIDS="$(lsof -ti tcp:"$BOARD_PORT" 2>/dev/null || true)"
    if [ -n "$PIDS" ]; then
      echo "$PIDS" | xargs kill 2>/dev/null && echo "board stopped (port $BOARD_PORT)" \
        || echo "could not stop board on port $BOARD_PORT" >&2
    else
      echo "board not running on port $BOARD_PORT"
    fi
    ;;

  status)
    echo "project.conf:"
    if [ -f "$DATA_DIR/project.conf" ]; then
      jq . "$DATA_DIR/project.conf"
    else
      echo "  (none — set CLAUDE_PLUGIN_OPTION_project_path and start a session, or run: ks-flow set-project <path>)"
    fi

    echo "daemon (launchd):"
    if launchctl print "gui/$UID_NUM/$LABEL" >/dev/null 2>&1; then
      launchctl print "gui/$UID_NUM/$LABEL" | grep -E 'state =|pid =' | sed 's/^/  /'
    else
      echo "  not loaded"
    fi

    echo "pocketbase (port $PB_PORT):"
    if curl -fsS "http://127.0.0.1:$PB_PORT/api/health" >/dev/null 2>&1; then
      echo "  healthy"
    elif pgrep -f "pocketbase serve" >/dev/null 2>&1; then
      echo "  running (starting up…)"
    else
      echo "  not running"
    fi

    echo "board UI (port $BOARD_PORT):"
    if lsof -ti tcp:"$BOARD_PORT" >/dev/null 2>&1; then
      echo "  running → http://localhost:$BOARD_PORT"
    else
      echo "  not running"
    fi

    if [ -f "$DATA_DIR/checkpoints.json" ]; then
      echo "tracked sessions: $(jq 'length' "$DATA_DIR/checkpoints.json")"
    fi
    ;;

  daemon)
    exec node "$DAEMON_DIR/dist/daemon.js"
    ;;

  archive)
    # Archive ONE worktree's transcript + workflow to GCS (the same step the
    # board runs before removing a completed worktree). Kept as a familiar verb;
    # there is only ONE uploader now, so it forwards to `backup --worktree`.
    WT="${2:-}"
    [ -n "$WT" ] || { echo "usage: ks-flow archive <worktree-path> [identifier]" >&2; exit 1; }
    exec node "$DAEMON_DIR/dist/transcript-backup.js" --worktree "$2" ${3:+--identifier "$3"} --force
    ;;

  backfill-archive)
    # Archive units whose worktree is GONE (completed work in the main checkout).
    # Same one uploader, different target selection.
    shift
    exec node "$DAEMON_DIR/dist/transcript-backup.js" --completed "$@"
    ;;

  backup)
    # Back up session transcripts changed in the last 24h (per-file objects, so
    # local 30-day pruning can never clobber an older session in the bucket).
    # Flags: --unit <id> (one ticket), --since-hours <n>, --all, --force,
    # --dry-run, --json. Same entrypoint the daemon's end-of-day sweep runs.
    shift
    exec node "$DAEMON_DIR/dist/transcript-backup.js" "$@"
    ;;

  restore)
    # Pull a unit's backed-up transcripts back into ~/.claude/projects/<encoded>.
    # Local files win unless --overwrite. Restores the conversation, NOT the
    # git worktree.
    shift
    exec node "$DAEMON_DIR/dist/transcript-restore.js" "$@"
    ;;

  migrate-archives)
    # Convert legacy whole-directory archives (<id>/transcript.tar.zst) into the
    # per-file layout, after server-side copying every affected object to a
    # safety prefix in the same bucket. Flags: --dry-run, --unit <id>,
    # --backup-prefix <p>, --skip-backup, --delete-legacy, --force, --json.
    shift
    exec node "$DAEMON_DIR/dist/migrate-legacy-archives.js" "$@"
    ;;

  install-daemon)
    # Back-compat alias for `start`.
    exec "$PLUGIN_ROOT/scripts/bootstrap.sh"
    ;;

  stop)
    # Stop everything: board UI, daemon (launchd), and PocketBase.
    PIDS="$(lsof -ti tcp:"$BOARD_PORT" 2>/dev/null || true)"
    if [ -n "$PIDS" ]; then
      echo "$PIDS" | xargs kill 2>/dev/null && echo "board stopped" || echo "could not stop board" >&2
    else
      echo "board not running"
    fi
    launchctl bootout "gui/$UID_NUM" "$PLIST" 2>/dev/null \
      && echo "daemon stopped" || echo "daemon not running"
    pkill -f "pocketbase serve" 2>/dev/null && echo "pocketbase stopped" || true
    ;;

  set-project)
    NEW="${2:-}"
    [ -n "$NEW" ] || { echo "usage: ks-flow set-project <path>" >&2; exit 1; }
    CLAUDE_PLUGIN_OPTION_project_path="$NEW" exec "$PLUGIN_ROOT/scripts/bootstrap.sh"
    ;;

  *)
    echo "usage: ks-flow {start|open|close|stop|status|daemon|set-project <path>|archive <worktree>|backfill-archive [--dry-run] [--force]|backup [--unit <id>] [--dry-run]|restore --unit <id>|migrate-archives [--dry-run]}" >&2
    exit 1
    ;;
esac
