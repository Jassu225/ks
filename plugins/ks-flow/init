#!/bin/bash
# ks-flow init — ks-flow is set up together with the ks plugin it depends on:
# this hands over to the ks plugin's setup (scripts/ks-setup). The daemon,
# PocketBase or Firestore and the board then install themselves on first use
# (SessionStart bootstrap + `ks-flow open`).
set -e
PLUGIN_DIR="$(cd "$(dirname "$0")" && pwd)"
chmod +x "$PLUGIN_DIR/bin/ks-flow" 2>/dev/null || true
KS_SETUP=""
for c in "$PLUGIN_DIR/../ks/scripts/ks-setup" "$(command -v ks-setup 2>/dev/null)"; do
  [ -n "$c" ] && [ -x "$c" ] && { KS_SETUP="$c"; break; }
done
if [ -z "$KS_SETUP" ]; then
  echo "ks not set up: ks-flow needs the ks plugin. Run plugins/ks/init (clone) or /ks:setup (installed)." >&2
  exit 1
fi
exec "$KS_SETUP" apply "$@"
