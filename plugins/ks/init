#!/bin/bash
# plugins/ks/init — set up the KS plugins from a clone. A thin wrapper over
# scripts/ks-setup, the same tool the /ks:setup skill runs for an install:
#   ./init        config folder, registry, command shims + PATH line, deps,
#                 project path, legacy config import, sandbox excludes, doctor
#   ./init-dev    the same, and loads the clone as the karmasuite directory
#                 marketplace, so a plain `claude` gets the plugins (live edits)
# Re-running is safe; every step that changes your Claude settings or Keychain asks.
set -e
PLUGIN_DIR="$(cd "$(dirname "$0")" && pwd)"
SETUP="$PLUGIN_DIR/scripts/ks-setup"
DEV=""
for a in "$@"; do
  case "$a" in
    --dev) DEV=--dev ;;
    *) echo "Unknown option: $a" >&2; exit 1 ;;
  esac
done

echo "=== ks CLI dependencies ==="
( cd "$PLUGIN_DIR/scripts" && npm ci --no-audit --no-fund )

"$SETUP" apply $DEV

echo ""
echo "=== Optional: claude-real-video (grain recording watch) ==="
if command -v crv >/dev/null 2>&1; then
  echo "crv found: $(command -v crv)"
else
  echo "Not installed. Later: pipx install \"claude-real-video[whisper]\" && brew install ffmpeg"
fi

echo ""
echo "=== Claude settings (sandbox excludes, statusline env) ==="
"$SETUP" claude-settings || true

echo ""
echo "=== Check ==="
"$SETUP" doctor || echo "Fix the items above (or run /ks:setup in Claude), then: ks-setup doctor"
