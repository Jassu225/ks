#!/bin/bash
# claude-ks-test — claude (via ks-claude) with the ks-browser plugin (browser testing: the
# agent-browser MCP server and the test-video skill) loaded for this session.
#
#   claude-ks-test [<claude-ks args>…]
#
# Every argument passes through to claude, e.g. `claude-ks-test --name KAR-123`.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/ks-claude" --local-plugin ks-browser "$@"
