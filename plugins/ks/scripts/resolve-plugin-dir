#!/bin/bash
# Usage: resolve-plugin-dir <plugin-name>
# Prints the folder of the named plugin: a KS plugin through ks-root (clone or
# installed, directory marketplaces read in place), any other plugin through
# `claude plugin list --json` (readFromFolder, else installPath; matched by
# <name>@<marketplace>, which the old installed_plugins.json lookup by bare
# name never matched).
PLUGIN_NAME="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -z "$PLUGIN_NAME" ]; then
  echo "Usage: resolve-plugin-dir <plugin-name>" >&2
  exit 1
fi

. "$SCRIPT_DIR/lib/ks-root.sh"
if DIR="$(ks_root "$PLUGIN_NAME")"; then
  echo "$DIR"
  exit 0
fi

echo "Error: $PLUGIN_NAME not found in installed plugins." >&2
echo "Install it first:" >&2
echo "  claude plugin install $PLUGIN_NAME" >&2
exit 1
