# ~/.config/ks/ks.env — plain (non-secret) settings of the ks plugin, created by
# `ks-setup apply`. Change values with `ks-config set ks.<KEY> <value>` or the
# /ks:config skill. Secrets are NOT kept here: they live in the macOS Keychain
# (`ks-config secret linear.LINEAR_API_KEY`, `slack.SLACK_TOKEN`,
# `grain.GRAIN_API_TOKEN`). Every key: scripts/lib/ks-config-keys.txt.

# Absolute path of your KarmaSuite checkout (quality hooks, launchers, ks-flow)
KS_PROJECT_ROOT_PATH=

# Legacy clone loading only: local plugins claude-ks adds with --plugin-dir.
# Not needed once the plugins are installed (ks-setup apply --dev).
# KS_EXTRA_PLUGINS="ks-flow"
