#!/bin/bash
set -euo pipefail

# Capture the directory where script was invoked BEFORE anything else
INVOKE_DIR="$(pwd)"

# Script to remove git worktrees for KarmaSuite project
# Usage: ./remove_worktree [-D] <worktree-path>
# Removes the worktree and optionally deletes the underlying branch

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Load .config for KS_PROJECT_ROOT_PATH
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_FILE="$(cd "$SCRIPT_DIR/.." && pwd)/.config"
KS_PROJECT_ROOT=""
if [[ -f "$CONFIG_FILE" ]]; then
    KS_PROJECT_ROOT=$(grep "^KS_PROJECT_ROOT_PATH=" "$CONFIG_FILE" | cut -d'=' -f2- || true)
    # Fallback to legacy key
    [[ -z "$KS_PROJECT_ROOT" ]] && KS_PROJECT_ROOT=$(grep "^PROJECT_ROOT_PATH=" "$CONFIG_FILE" | cut -d'=' -f2- || true)
fi

if [[ -z "$KS_PROJECT_ROOT" ]]; then
    echo -e "${RED}[ERROR]${NC} KS_PROJECT_ROOT_PATH not configured in .config" >&2
    echo "Run ./init to configure the project root path." >&2
    exit 1
fi

# Resolve INVOKE_DIR to its real path for comparison
RESOLVED_INVOKE_DIR="$(cd "$INVOKE_DIR" && pwd -P)"
RESOLVED_KS_ROOT="$(cd "$KS_PROJECT_ROOT" 2>/dev/null && pwd -P)" || {
    echo -e "${RED}[ERROR]${NC} KS_PROJECT_ROOT_PATH does not exist: ${KS_PROJECT_ROOT}" >&2
    exit 1
}

if [[ "$RESOLVED_INVOKE_DIR" != "$RESOLVED_KS_ROOT" ]]; then
    echo -e "${RED}[ERROR]${NC} Must be run from KS project root: ${KS_PROJECT_ROOT}" >&2
    echo "  Current directory: ${INVOKE_DIR}" >&2
    exit 1
fi

# Parse arguments (handle -D flag in any position)
DELETE_BRANCH=false
WORKTREE_PATH=""

for arg in "$@"; do
    case $arg in
        -D)
            DELETE_BRANCH=true
            ;;
        -*)
            error "Invalid option: $arg"
            exit 1
            ;;
        *)
            if [[ -z "$WORKTREE_PATH" ]]; then
                WORKTREE_PATH="$arg"
            else
                error "Unexpected argument: $arg"
                exit 1
            fi
            ;;
    esac
done

# Validate arguments
if [[ -z "$WORKTREE_PATH" ]]; then
    error "Worktree path is required"
    echo ""
    echo "Usage: $0 [-D] <worktree-path>"
    echo ""
    echo "Arguments:"
    echo "  worktree-path    Path to the worktree to remove (required)"
    echo ""
    echo "Options:"
    echo "  -D               Also delete the underlying branch"
    echo ""
    echo "Examples:"
    echo "  $0 ../karmasuite-worktree/my-feature        # Remove worktree only"
    echo "  $0 -D ../karmasuite-worktree/my-feature     # Remove worktree and delete branch"
    echo "  $0 ../karmasuite-worktree/my-feature -D     # -D can be in any position"
    exit 1
fi

# Resolve to absolute path
if [[ ! "$WORKTREE_PATH" = /* ]]; then
    WORKTREE_PATH="$(cd "$(dirname "$WORKTREE_PATH")" 2>/dev/null && pwd)/$(basename "$WORKTREE_PATH")" || WORKTREE_PATH="$(pwd)/$1"
fi

# Check if the worktree exists in git's worktree list
WORKTREE_INFO=$(git -C "$KS_PROJECT_ROOT" worktree list --porcelain | grep -A2 "worktree $WORKTREE_PATH$" || true)

if [[ -z "$WORKTREE_INFO" ]]; then
    error "Worktree not found: ${WORKTREE_PATH}"
    echo ""
    echo "Available worktrees:"
    git -C "$KS_PROJECT_ROOT" worktree list
    exit 1
fi

# Extract the branch name from the worktree info
BRANCH_NAME=$(echo "$WORKTREE_INFO" | grep "^branch " | sed 's/branch refs\/heads\///')

if [[ -z "$BRANCH_NAME" ]]; then
    warn "Could not determine branch name for worktree"
    if [[ "$DELETE_BRANCH" = true ]]; then
        error "Cannot delete branch: branch name could not be determined"
        exit 1
    fi
fi

info "Removing worktree..."
info "  Path: ${WORKTREE_PATH}"
if [[ -n "$BRANCH_NAME" ]]; then
    info "  Branch: ${BRANCH_NAME}"
fi
if [[ "$DELETE_BRANCH" = true ]]; then
    info "  Will also delete branch: yes"
fi
echo ""

# ============================================================================
# Pre-removal: clean up, check for changes, and copy workflow back
# ============================================================================

# Step 1: cd into the worktree and restore .claude/
info "Cleaning up worktree..."
cd "$WORKTREE_PATH"
git restore --source=HEAD -- .claude/ 2>/dev/null || true
success "Restored .claude/ to clean state"

# Step 2: Check for uncommitted changes (staged, unstaged, and untracked)
DIRTY=""
if [[ -n "$(git status --porcelain)" ]]; then
    DIRTY=true
fi

if [[ -n "$DIRTY" ]]; then
    error "Worktree has uncommitted changes. Clean up before removing."
    echo ""
    git status --short
    echo ""
    echo "Commit or discard changes, then retry."
    exit 1
fi
success "Worktree is clean"

# Step 3: Find state.yaml with worktree_dir matching this worktree and copy workflow back
# Build tilde-prefixed path for matching (worktree_dir uses ~ for $HOME)
TILDE_WORKTREE_PATH="${WORKTREE_PATH/#$HOME/\~}"

# Search for state.yaml files with matching worktree_dir
STATE_FILE=""
while IFS= read -r candidate; do
    if grep -q "worktree_dir:.*${TILDE_WORKTREE_PATH}" "$candidate" 2>/dev/null; then
        STATE_FILE="$candidate"
        break
    fi
done < <(find "$WORKTREE_PATH/workflow" -name "state.yaml" 2>/dev/null)

# Fallback: state.yamls written before worktree_dir existed have no such line.
# Ticket worktrees are named <identifier>-<slug> (e.g. kar-11331-date-selector-…),
# so match the state.yaml whose identifier is that ticket instead.
if [[ -z "$STATE_FILE" ]]; then
    TICKET_ID=$(basename "$WORKTREE_PATH" | grep -oE '^[A-Za-z]+-[0-9]+' | tr '[:lower:]' '[:upper:]')
    if [[ -n "$TICKET_ID" ]]; then
        while IFS= read -r candidate; do
            if grep -qE "^[[:space:]]*identifier:[[:space:]]*[\"']?${TICKET_ID}[\"']?[[:space:]]*$" "$candidate" 2>/dev/null; then
                STATE_FILE="$candidate"
                warn "No worktree_dir in any state.yaml; matched ${TICKET_ID} by identifier"
                break
            fi
        done < <(find "$WORKTREE_PATH/workflow" -ipath "*/tickets/${TICKET_ID}/state.yaml" 2>/dev/null)
    fi
fi

if [[ -n "$STATE_FILE" ]]; then
    info "Found workflow state: ${STATE_FILE}"

    # Extract username from whoami.username in state.yaml
    # Works for both project and ticket workflows (whoami is nested under project: or ticket:)
    LINEAR_USERNAME=$(grep -A4 "whoami:" "$STATE_FILE" | grep "username:" | head -1 | sed 's/.*username:[[:space:]]*//' | sed 's/^["'"'"']//;s/["'"'"']$//')

    if [[ -n "$LINEAR_USERNAME" ]]; then
        # Determine the workflow project folder (parent of state.yaml)
        WORKFLOW_PROJECT_DIR="$(dirname "$STATE_FILE")"
        WORKFLOW_PROJECT_NAME="$(basename "$WORKFLOW_PROJECT_DIR")"

        # Determine destination: check if this is a ticket or project workflow
        # Ticket workflows live under workflow/<username>/tickets/<identifier>/
        PARENT_OF_PROJECT="$(basename "$(dirname "$WORKFLOW_PROJECT_DIR")")"
        if [[ "$PARENT_OF_PROJECT" == "tickets" ]]; then
            DEST_DIR="$KS_PROJECT_ROOT/workflow/$LINEAR_USERNAME/tickets/$WORKFLOW_PROJECT_NAME"
        else
            DEST_DIR="$KS_PROJECT_ROOT/workflow/$LINEAR_USERNAME/$WORKFLOW_PROJECT_NAME"
        fi

        info "Copying workflow back to main repo..."
        info "  From: ${WORKFLOW_PROJECT_DIR}"
        info "  To:   ${DEST_DIR}"
        mkdir -p "$DEST_DIR"
        cp -r "$WORKFLOW_PROJECT_DIR/"* "$DEST_DIR/"
        success "Workflow copied to main repo"
    else
        error "Could not extract username from state.yaml"
        exit 1
    fi
else
    error "No state.yaml with matching worktree_dir (or ticket identifier) found in ${WORKTREE_PATH}/workflow/"
    echo "Workflow data would be lost. Aborting removal."
    exit 1
fi

# Step 4: cd back to main project root before removal
cd "$KS_PROJECT_ROOT"

# Step 5: back up the worktree's sessions, workflow and time log to the cloud,
# when ks-flow's cloud (GCS) backup is switched on — the same step the ks-flow
# board runs before its Remove. The board sets KS_FLOW_BACKED_UP=1 once it has
# done so, which skips a second upload. A failed backup aborts the removal.
if [[ "${KS_FLOW_BACKED_UP:-}" == "1" ]]; then
    info "Cloud backup already done by the ks-flow board"
elif ! command -v ks-flow >/dev/null 2>&1; then
    info "ks-flow not installed — skipping cloud backup"
elif ! ks-flow backup-enabled; then
    info "Cloud backup is off in ks-flow settings — skipping it"
else
    BACKUP_ID=""
    if [[ "$PARENT_OF_PROJECT" == "tickets" ]]; then
        BACKUP_ID=$(grep -m1 -E '^[[:space:]]+identifier:' "$STATE_FILE" | sed 's/.*identifier:[[:space:]]*//; s/^["'"'"']//; s/["'"'"'][[:space:]]*$//')
    fi
    info "Backing up sessions + workflow to the cloud${BACKUP_ID:+ (${BACKUP_ID})}..."
    if ! ks-flow archive "$WORKTREE_PATH" ${BACKUP_ID:+"$BACKUP_ID"}; then
        error "Cloud backup failed. Aborting removal (nothing was deleted)."
        echo "Fix the GCS settings/credentials, or turn cloud backup off in the ks-flow board's Settings, then retry."
        exit 1
    fi
    success "Backed up to the cloud"
fi

# ============================================================================
# Remove the worktree
# ============================================================================

info "Removing git worktree..."
if ! git -C "$KS_PROJECT_ROOT" worktree remove "$WORKTREE_PATH"; then
    error "Failed to remove worktree"
    echo ""
    echo "If the worktree has uncommitted changes, use:"
    echo "  git worktree remove --force ${WORKTREE_PATH}"
    exit 1
fi
success "Git worktree removed"

# Delete the branch if -D was provided
if [[ "$DELETE_BRANCH" = true ]] && [[ -n "$BRANCH_NAME" ]]; then
    info "Deleting branch '${BRANCH_NAME}'..."
    if ! git -C "$KS_PROJECT_ROOT" branch -D "$BRANCH_NAME"; then
        error "Failed to delete branch: ${BRANCH_NAME}"
        exit 1
    fi
    success "Branch '${BRANCH_NAME}' deleted"
fi

echo ""
success "Worktree removal complete!"
