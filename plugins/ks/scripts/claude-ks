#!/bin/bash
# claude-ks — the way to start Claude for KarmaSuite (in the checkout or one of
# its worktrees). A plain `claude` gets the plugins, rules, task list and tokens
# too; claude-ks adds:
#   - the session (peer) name: the workflow unit (KAR-123), prefixed with this
#     Mac's ks-flow device label once 2+ Macs share the board (B:KAR-123), so
#     agents on other Macs can tell it apart and message it;
#   - Remote Control when it is on (ks.KS_REMOTE_CONTROL=1, `ks-setup remote-control`);
#   - on-demand plugins: --local-plugin / --plugin <name> (ks-master, ks-browser)
#     load for this session only.
#
#   claude-ks [--local-plugin <name>]… [claude args…]
#
# It runs scripts/ks-claude, the launcher behind every KS launcher (old clone
# setup included).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/ks-claude" "$@"
