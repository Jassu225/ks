#!/bin/bash
# claude-ks — DEPRECATED. Once the plugins are installed (ks-setup apply --dev for
# a clone, or `claude plugin install ks-suite@karmasuite`), a plain `claude` gets
# the same plugins, rules, task list and tokens, and so do the desktop app and
# IDEs. Kept for one release: it still works, through scripts/ks-claude (old
# clone setup included). Same arguments as before (--plugin / --local-plugin
# <name>, then any claude arguments).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ "$(jq -r '.enabledPlugins["ks@karmasuite"] // false' "$HOME/.claude/settings.json" 2>/dev/null)" = true ]; then
  echo "claude-ks is deprecated: plain \`claude\` does the same now (claude -n <name> to name a session)." >&2
else
  echo "claude-ks is deprecated: run plugins/ks/init-dev (or /ks:setup) once, then use plain \`claude\`." >&2
fi
exec "$SCRIPT_DIR/ks-claude" "$@"
