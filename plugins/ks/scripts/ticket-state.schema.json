{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karmasuite.com/schemas/ticket-state.schema.json",
  "title": "KarmaSuite Ticket Workflow State",
  "description": "Schema for KarmaSuite single ticket workflow state files",
  "type": "object",
  "required": ["ticket", "phases"],
  "additionalProperties": false,
  "properties": {
    "worktree_dir": {
      "type": "string",
      "description": "Absolute path to the git worktree directory, with ~ for home (e.g., '~/karmasuite/karmasuite-worktree/my-feature')"
    },
    "ticket": {
      "type": "object",
      "description": "Linear ticket/issue information",
      "required": ["id", "identifier", "name", "url", "dates", "priority"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Linear issue UUID"
        },
        "identifier": {
          "type": "string",
          "pattern": "^[A-Z]+-\\d+$",
          "description": "Linear issue identifier (e.g., 'KAR-123')"
        },
        "name": {
          "type": "string",
          "description": "Issue title"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Linear issue URL"
        },
        "summary": {
          "type": ["string", "null"],
          "description": "Issue description/details"
        },
        "dates": {
          "type": "object",
          "required": ["created_at", "updated_at"],
          "additionalProperties": false,
          "properties": {
            "created_at": {
              "type": "string",
              "format": "date-time",
              "description": "Issue creation timestamp (ISO 8601)"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "description": "Last update timestamp (ISO 8601)"
            },
            "due_date": {
              "type": ["string", "null"],
              "format": "date",
              "description": "Due date (YYYY-MM-DD)"
            }
          }
        },
        "priority": {
          "type": "object",
          "required": ["value", "name"],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 4,
              "description": "Priority level (0=None, 1=Urgent, 2=High, 3=Medium, 4=Low)"
            },
            "name": {
              "type": "string",
              "enum": ["None", "Urgent", "High", "Medium", "Low"],
              "description": "Priority name"
            }
          }
        },
        "status": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "State UUID"
            },
            "name": {
              "type": "string",
              "description": "State name (e.g., 'In Progress', 'Todo', 'Done')"
            }
          },
          "required": ["id", "name"]
        },
        "labels": {
          "type": "array",
          "description": "Issue labels",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "assignee": {
          "type": ["object", "null"],
          "description": "Issue assignee",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["id", "name"]
        },
        "whoami": {
          "type": ["object", "null"],
          "description": "The Linear user who owns the API key used to create this state",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "User UUID"
            },
            "name": {
              "type": "string",
              "description": "User full name"
            },
            "username": {
              "type": "string",
              "description": "User's Linear username/handle"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "User email address"
            }
          },
          "required": ["id", "name", "username", "email"]
        },
        "estimate": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Story points estimate"
        },
        "parent_project": {
          "type": ["object", "null"],
          "description": "Parent project (if any)",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Project UUID"
            },
            "name": {
              "type": "string",
              "description": "Project name"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Project URL"
            }
          },
          "required": ["id", "name", "url"]
        }
      }
    },
    "phases": {
      "type": "array",
      "description": "Workflow phases tracking",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "slack": {
      "type": "object",
      "description": "Slack thread references for communication tracking",
      "additionalProperties": false,
      "properties": {
        "project_thread": {
          "$ref": "#/$defs/slack_thread",
          "description": "General project/task communication thread"
        },
        "release_thread": {
          "$ref": "#/$defs/slack_thread",
          "description": "Release announcement thread (stored for reference)"
        }
      },
      "required": ["project_thread", "release_thread"]
    },
    "prs": {
      "type": "array",
      "description": "Pull requests raised for this workflow, recorded at PR-creation time (latest appended at end)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri", "description": "GitHub PR URL" },
          "branch": { "type": "string", "description": "Head branch of the PR" },
          "created_at": { "type": "string", "format": "date-time", "description": "When the PR was created (ISO 8601)" },
          "review_thread": {
            "$ref": "#/$defs/slack_thread",
            "description": "Slack PR review request thread; null until the PR is sent for review"
          }
        },
        "required": ["url", "branch", "created_at", "review_thread"]
      }
    }
  },
  "$defs": {
    "slack_thread": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "channel_id": { "type": "string", "description": "Slack channel ID (e.g., 'C051A3TSM5K')" },
        "channel_name": { "type": "string", "description": "Slack channel name (e.g., '#engineering')" },
        "ts": { "type": "string", "description": "Slack message timestamp (e.g., '1234567890.123456')" },
        "url": { "type": ["string", "null"], "format": "uri", "description": "Slack message permalink" }
      },
      "required": ["channel_id", "channel_name", "ts"]
    },
    "phase": {
      "type": "object",
      "description": "A workflow phase. Phases that support iteration (implementation-plan-creation, implementation) track timestamps in the iterations array instead of the top-level started_at/ended_at",
      "required": ["number", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0,
          "description": "Phase number (0 = initialization, then sequential)"
        },
        "name": {
          "type": "string",
          "description": "Phase name (e.g., 'ticket-initialization', 'research', 'implementation')"
        },
        "status": {
          "type": "string",
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "SKIPPED"],
          "description": "Current phase status"
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When the phase was started (ISO 8601). Not used by iterating phases — see iterations"
        },
        "ended_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When the phase was completed/skipped (ISO 8601). Not used by iterating phases — see iterations"
        },
        "iterations": {
          "type": "array",
          "description": "Iteration history for phases that can cycle (phases 9 and 10). Used instead of top-level started_at/ended_at; the current iteration number is the array length",
          "items": {
            "type": "object",
            "required": ["started_at", "ended_at"],
            "additionalProperties": false,
            "properties": {
              "started_at": {
                "type": ["string", "null"],
                "format": "date-time",
                "description": "When the iteration was started (ISO 8601)"
              },
              "ended_at": {
                "type": ["string", "null"],
                "format": "date-time",
                "description": "When the iteration was completed (ISO 8601), null while in progress"
              }
            }
          }
        }
      }
    }
  }
}
