#!/bin/bash
# ks-setup — set up and check the KS plugins on this machine. One tool behind
# both entry points: plugins/ks/init (a clone) and the /ks:setup skill (an
# install). Idempotent; nothing that needs a secret or your consent happens
# without asking.
#
#   ks-setup doctor [--json]       read-only check of everything; exit 1 on errors
#   ks-setup apply [--dev] [--yes] folders, registry, shims, PATH line, deps, project
#                                  path, legacy import; --dev also loads the clone
#                                  as a directory marketplace (claude plugin ...)
#   ks-setup claude-settings --self    first step, with the sandbox on: exclude only
#                                  ks-setup itself, so Claude can run the rest of setup
#   ks-setup claude-settings [--yes] [--ks-flow]   (alias: sandbox) the deny rules on
#                                  the agent running `security`, env KS_MOD_STATUSLINE and,
#                                  with the sandbox on, the KS commands in
#                                  sandbox.excludedCommands (ks-flow's only when ks-flow
#                                  is enabled in the project, or with --ks-flow), in
#                                  ~/.claude/settings.json (backup: settings.json.bak-ks)
#   ks-setup statusline [--yes]    optional: the KS status line in the KarmaSuite
#                                  checkout (its .claude/settings.local.json and
#                                  its worktrees), runs ~/.local/bin/statusline
#   ks-setup remote-control [--yes|--remove]  optional, suggested once 2+ devices
#                                  share the ks-flow board: a `claude` shell function
#                                  that adds --rc in the KarmaSuite checkout and its
#                                  worktrees, so agents can message across machines
#   ks-setup version [--json]      each KS plugin's version: the copy the commands run,
#                                  the one Claude loads, the marketplace's newest, and
#                                  ks-flow's daemon and store; with the fix when behind
#   ks-setup update [--check] [--no-restart] [--json] [--auto]   bring every KS plugin
#                                  on this machine to the newest release: installed, each
#                                  out-of-date install (the checkout and every worktree)
#                                  through `claude plugin update`; a clone on a clean
#                                  main, `git pull --ff-only`. Then the shims, and
#                                  ks-flow restarts when it changed (not with --no-restart).
#                                  --check only looks. Exit 0 updated / current /
#                                  available, 1 refused or failed, 2 usage, 3 another
#                                  update is running. Log: ~/.config/ks/update.log
#   ks-setup shims                 quiet: rewrite the ~/.local/bin shims, prune the registry
#   ks-setup tools [--yes] [name...]   install the missing tools setup checks (node,
#                                  git, jq, tmux, terminal-notifier, zstd, ffmpeg, gh)
#                                  with Homebrew; only those, after a yes
#   ks-setup store pocketbase | firestore --project <gcp id> --credentials <key.json>
#                                  ks-flow's store, written to its per-project .env
#
# Without a terminal (from Claude's Bash tool) every question becomes a printed
# `!` command to run instead.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/lib/ks-config.sh"
. "$SCRIPT_DIR/lib/ks-root.sh"
KS_ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SETTINGS="$HOME/.claude/settings.json"
LOCAL_BIN="$HOME/.local/bin"
MARKETPLACE=karmasuite
# Commands the sandbox must not run (they need the Keychain, tmux, git worktrees,
# the network or files outside the project); each also as "<cmd> *".
# ks-setup comes first and alone (`claude-settings --self`, which you run): once
# it is excluded, Claude can run the rest of setup, including the other entries
# (after you agree). ks-flow's entry is added only when ks-flow is in use.
EXCLUDED=(linear slack grain gh ks-config ks-time ks-start-ticket create-worktree
  tmux claude-ks-master claude-ks-rc claude-ks-rc-restart quit-chrome mem-info)
SELF_EXCLUDED=ks-setup
FLOW_EXCLUDED=ks-flow
# Where Claude may turn the sandbox on (managed settings win; any of them on = on).
MANAGED_SETTINGS="/Library/Application Support/ClaudeCode/managed-settings.json"
# Deny rules so the agent can't read the KS tokens out of the Keychain itself
# (`security find-generic-password -w`): the sandbox doesn't block the Keychain.
# They match only the command line the agent writes, so the KS CLIs, which call
# `security` themselves, keep working. A guard against accidents and casual
# prompt injection, not a wall: a wrapped call (sh -c, a script) gets past it.
DENY=('Bash(security *)' 'Bash(/usr/bin/security *)')
# Commands that get a ~/.local/bin shim (plugin:command).
SHIMS=(ks:linear ks:slack ks:grain ks:ks-time ks:ks-config ks:ks-setup ks:ks-root ks:claude-ks ks:ks-claude
  ks:claude-ks-master ks:claude-ks-rc ks:claude-ks-rc-restart ks:claude-ks-test ks:ks-master-view
  ks:remove_worktree ks:create-worktree ks:ks-start-ticket ks:ks-start-project ks:quality-typecheck.sh
  ks:spec_metadata.sh ks:deploy.sh ks:pre-deploy.sh ks:quit-chrome ks:mem-info ks:resolve-plugin-dir ks:statusline
  ks-flow:ks-flow)
# The status line command written by `ks-setup statusline`: the shim, so it
# follows plugin updates and needs no PATH.
STATUSLINE_CMD='~/.local/bin/statusline'
YES=0
DEVICE_COUNT=""   # devices sharing the ks-flow store (device_check); empty when unknown
# The shell block `ks-setup remote-control` writes into the rc file.
RC_BEGIN='# >>> ks remote-control (ks-setup remote-control) >>>'
RC_END='# <<< ks remote-control <<<'
interactive() { [ "$YES" = 0 ] && [ -t 0 ] && [ -t 1 ]; }
ask() { # question → 0 for yes
  [ "$YES" = 1 ] && return 0
  interactive || return 1
  local a; read -rp "$1 [y/N]: " a; [[ "$a" =~ ^[Yy] ]]
}
say() { printf '%s\n' "$*"; }

# ── shell rc file (approval note: zsh → ~/.zshrc; bash → ~/.bash_profile on macOS, else ~/.bashrc)
rc_file() {
  case "$(basename "${SHELL:-}")" in
    zsh) echo "$HOME/.zshrc" ;;
    bash) if [ "$(uname -s)" = Darwin ]; then echo "$HOME/.bash_profile"; else echo "$HOME/.bashrc"; fi ;;
    *) return 1 ;;
  esac
}

# ── doctor ──────────────────────────────────────────────────────────────────
CHECKS=()
check() { # id level(error|warn|info) ok(0|1) message [fix]
  CHECKS+=("$(jq -nc --arg id "$1" --arg level "$2" --argjson ok "$3" --arg msg "$4" --arg fix "${5:-}" \
    '{id:$id,level:$level,ok:($ok==1),message:$msg,fix:(if $fix=="" then null else $fix end)}')")
}
have() { command -v "$1" >/dev/null 2>&1; }

load_mode() {
  local en="" src="" f proj
  # Enabled at user scope, or (a per-project install) in the KS project's own
  # .claude/settings.local.json / settings.json — the later file wins, as in Claude.
  proj="$(ksc_project_root 2>/dev/null || true)"
  for f in "$SETTINGS" ${proj:+"$proj/.claude/settings.json" "$proj/.claude/settings.local.json"}; do
    local v; v="$(jq -r --arg m "$MARKETPLACE" '.enabledPlugins["ks@"+$m] // empty' "$f" 2>/dev/null)"
    [ -n "$v" ] && en="$v"
  done
  src="$(jq -r --arg m "$MARKETPLACE" '.[$m].source | (.path // .url // .repo // empty)' \
    "$HOME/.claude/plugins/known_marketplaces.json" 2>/dev/null)"
  if [ "$en" = true ] && [ -n "$src" ] && [ -d "$src" ]; then echo dev-marketplace
  elif [ "$en" = true ]; then echo marketplace
  else echo launcher; fi
}

# This device on the shared ks-flow board (ks-flow README, "Several devices"):
# its id (`ks-flow device-id --json`: the hashed hardware id, or KS_DEVICE_ID)
# and name and, with Firestore, whether the store is set up for devices
# (meta/settings, read by the daemon's store-check). Info only.
device_check() { # flow-root data-dir store
  local flow="$1" dd="$2" dbp="$3" fbin=ks-flow dev did dname sc="" setup master
  have ks-flow || fbin="$flow/bin/ks-flow"
  dev="$("$fbin" device-id --json 2>/dev/null)"
  did="$(jq -r '.deviceId // empty' <<<"$dev" 2>/dev/null)"
  dname="$(jq -r '.defaultName // empty' <<<"$dev" 2>/dev/null)"
  if [ -z "$did" ]; then
    check ks-flow:device info 0 "this device's ks-flow id is unknown (daemon not built yet)" "ks-flow start"; return
  fi
  local me="this device: ${dname:-unnamed} ($did)"
  # A stored id that isn't this machine's hardware id: the config came from
  # another Mac (Migration Assistant, synced dotfiles) or the logic board was
  # replaced. Two Macs with one id overwrite each other's cards.
  if [ "$(jq -r '"\(.source // "")/\(.hardwareMatches)"' <<<"$dev" 2>/dev/null)" = config/false ]; then
    check ks-flow:device-id warn 0 \
      "the stored device id $did (ks.KS_DEVICE_ID) is not this machine's own: copied from another Mac, or the logic board was replaced; if another Mac uses $did, the two overwrite each other's cards" \
      "on the copied Mac: ks-config unset ks.KS_DEVICE_ID, then ks-flow stop && ks-flow start"
  fi
  if [ "$dbp" != firestore ]; then check ks-flow:device info 1 "$me"; return; fi
  [ -n "$dd" ] && [ -f "$dd/daemon/dist/store-check.js" ] \
    && sc="$(KS_FLOW_DATA="$dd" node "$dd/daemon/dist/store-check.js" --json 2>/dev/null)"
  [ -n "$sc" ] || sc='{}'
  setup="$(jq -r 'if .ok then (.devicesSetUp // false | tostring) else "unknown" end' <<<"$sc" 2>/dev/null)"
  master="$(jq -r '.masterDeviceId // empty' <<<"$sc" 2>/dev/null)"
  DEVICE_COUNT="$(jq -r '.devices // empty' <<<"$sc" 2>/dev/null)"
  case "$setup" in
    true) check ks-flow:device info 1 "$me; store set up for devices${DEVICE_COUNT:+ ($DEVICE_COUNT)}, master device $master$([ "$master" = "$did" ] && echo ' (this one)')" ;;
    false) check ks-flow:device info 0 \
      "$me; the store is not set up for devices yet (no meta/settings); the backfill runs once, on the device that has been using the board" \
      "run the device backfill: cd \"$flow/src\" && npm ci && npx tsx ../scripts/one-off/backfill-devices.ts --data-dir \"$dd\" --dry-run   (then without --dry-run; ks-flow README, \"Several devices\")" ;;
    *) check ks-flow:device info 0 "$me; the store did not answer, so whether it is set up for devices is unknown" "ks-flow status" ;;
  esac
}

# This device's ks-flow against the store's (ks-flow README "Versioning"):
# <data-dir>/version-status.json, written by the daemon every minute. Behind on
# the data format: an error (its board is read-only, its store writes are off);
# behind on the release, or a failed update: a warning; else the version.
version_check() { # data-dir
  local dd="$1" f row
  f="$dd/version-status.json"
  if [ -z "$dd" ] || [ ! -f "$f" ]; then
    check ks-flow:version info 0 "ks-flow's version on this device is unknown (the daemon hasn't written version-status.json yet)" "ks-flow start"; return
  fi
  row="$(jq -r '
    def failed: ((.update.state // "") as $s | $s == "failed" or $s == "refused");
    def why: if .dev then "dev build: \(.devReason // "not a release")"
             elif failed then "the last update failed: \(.update.reason // "see update.log")"
             else "it updates itself" end;
    if .schemaBehind then
      ["error", 0, "ks-flow \(.version) on this device is behind the store'"'"'s data format (schema \(.schemaVersion) < \(.storeSchemaVersion)): its board is read-only and its store writes are off; \(why)", "ks-flow update"]
    elif .versionBehind then
      ["warn", 0, "ks-flow \(.version) on this device is behind the store'"'"'s \(.storeVersion); \(why)", "ks-flow update"]
    elif failed then
      ["warn", 0, "ks-flow \(.version): the last update failed: \(.update.reason // "see update.log")", "ks-flow update"]
    else
      ["info", 1, "ks-flow \(.version) (data format \(.schemaVersion))\(if .storeVersion then ", up to date with the store" else "" end)\(if .dev then "; dev build: \(.devReason // "not a release")" else "" end)", ""]
    end | @tsv' "$f" 2>/dev/null)"
  if [ -z "$row" ]; then check ks-flow:version warn 0 "ks-flow's version-status.json is unreadable" "ks-flow start"; return; fi
  local level ok msg fix
  IFS=$'\t' read -r level ok msg fix <<<"$row"
  check ks-flow:version "$level" "$ok" "$msg" "$fix"
  # The daemon's hourly release check (`ks-setup update --check`), when it has run.
  row="$(jq -r '
    (.release // null) as $r | select($r | type == "object")
    | ($r.checkedAt // "" | tostring | .[0:16] | sub("T"; " ")) as $at
    | ([$r.plugins[]? | select(.installed != .latest) | "\(.plugin) \(.installed // "?") → \(.latest // "?")"] | join(", ")) as $new
    | if $r.state == "available" then ["warn", 0, "a new KS release: \($new)\(if $at != "" then " (checked \($at))" else "" end)", "ks-setup update   (ks-flow also runs it itself)"]
      elif $r.state == "current" then ["info", 1, "KS plugins are the newest release\(if $at != "" then " (checked \($at))" else "" end)", ""]
      elif $r.state == "failed" then ["info", 0, "the release check failed: \($r.reason // "see ~/.config/ks/update.log")", "ks-setup update --check"]
      elif $r.state == "refused" then ["info", 1, "no release check: \($r.reason // "refused")", ""]
      else empty end | @tsv' "$f" 2>/dev/null)"
  [ -n "$row" ] || return 0
  IFS=$'\t' read -r level ok msg fix <<<"$row"
  check ks-flow:release "$level" "$ok" "$msg" "$fix"
}

# The sandbox is on in any of Claude's settings files (user, the KS project's,
# managed). Off, nothing needs excluding.
sandbox_enabled() {
  local proj f
  proj="$(ksc_project_root 2>/dev/null || true)"
  for f in "$SETTINGS" ${proj:+"$proj/.claude/settings.json" "$proj/.claude/settings.local.json"} "$MANAGED_SETTINGS"; do
    [ "$(jq -r '.sandbox.enabled // empty' "$f" 2>/dev/null)" = true ] && return 0
  done
  return 1
}
# ks-flow is enabled in the KS project (or user-wide): its own entry or the bundle.
flow_enabled() {
  local proj f v
  proj="$(ksc_project_root 2>/dev/null || true)"
  for f in "$SETTINGS" ${proj:+"$proj/.claude/settings.json" "$proj/.claude/settings.local.json"}; do
    v="$(jq -r --arg m "$MARKETPLACE" '(.enabledPlugins["ks-flow@"+$m] // .enabledPlugins["ks-suite@"+$m]) // empty' "$f" 2>/dev/null)"
    [ "$v" = true ] && return 0
  done
  return 1
}
# The fix for a missing Claude setting: Claude runs it once you agree, unless the
# sandbox still holds ks-setup (then the --self step, which you run, comes first).
cs_fix() {
  if sandbox_enabled && ! is_excluded "$SELF_EXCLUDED"; then echo "! ks-setup claude-settings --self, then ks-setup claude-settings --yes"
  else echo "ks-setup claude-settings --yes   (Claude runs it once you agree)"; fi
}
is_excluded() { # cmd → both "cmd" and "cmd *" in the user settings
  jq -e --arg c "$1" '(.sandbox.excludedCommands // []) | (index($c) != null) and (index($c + " *") != null)' "$SETTINGS" >/dev/null 2>&1
}
want_excluded() { # the entries this machine needs (ks-setup's own excluded)
  printf '%s\n' "${EXCLUDED[@]}"
  { flow_enabled || [ "${WITH_FLOW:-0}" = 1 ]; } && printf '%s\n' "$FLOW_EXCLUDED"
  return 0
}

doctor() {
  local json=0; [ "${1:-}" = --json ] && json=1
  CHECKS=()
  # First, because nothing else in setup works from Claude without it.
  if sandbox_enabled && ! is_excluded "$SELF_EXCLUDED"; then
    check sandbox:ks-setup error 0 "the sandbox is on and runs ks-setup inside it, so setup can't write ~/.local/bin, your shell's startup file or Claude's settings; exclude ks-setup first" "! ks-setup claude-settings --self"
  fi
  if have node; then
    local v; v="$(node -p 'process.versions.node' 2>/dev/null)"
    if node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>18||(a===18&&b>=17)?0:1)'
    then check tool:node error 1 "node $v"; else check tool:node error 0 "node $v is older than 18.17" "ks-setup tools --yes node"; fi
  else check tool:node error 0 "node is missing" "ks-setup tools --yes node"; fi
  local t lvl
  for t in npm:error git:error jq:error tmux:warn terminal-notifier:warn zstd:warn ffmpeg:info gh:info; do
    lvl="${t#*:}"; t="${t%%:*}"
    if have "$t"; then check "tool:$t" "$lvl" 1 "$t found"
    else check "tool:$t" "$lvl" 0 "$t is missing" "ks-setup tools --yes $(tool_formula "$t")"; fi
  done

  local mode; mode="$(load_mode)"
  case "$mode" in
    dev-marketplace) check load info 1 "plugins load from the clone (directory marketplace $MARKETPLACE)" ;;
    marketplace) check load info 1 "plugins installed from the $MARKETPLACE marketplace" ;;
    *) check load warn 0 "plugins load only through claude-ks (--plugin-dir); plain claude, the desktop app and IDEs get none" \
         "ks-setup apply --dev   (clone)  or, in your KarmaSuite checkout:  claude plugin install --scope local ks-suite@$MARKETPLACE" ;;
  esac
  local p root
  for p in ks:error ks-flow:warn; do
    lvl="${p#*:}"; p="${p%%:*}"
    if root="$(ks_root "$p")"; then check "plugin:$p" "$lvl" 1 "$p at $root"
    else check "plugin:$p" "$lvl" 0 "$p not found" "in your KarmaSuite checkout: claude plugin install --scope local $p@$MARKETPLACE"; fi
  done
  # On-demand plugins are never installed: their launchers load them with
  # --plugin-dir from the marketplace's copy of the repo. An install of one
  # (any scope) blocks that copy, and enabling one via settings made Claude
  # Code install it user-wide.
  local ip; ip="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json"
  for p in ks-master ks-browser; do
    if root="$(ksr_marketplace_root "$p")"; then check "plugin:$p" info 1 "$p loads on demand from $root"
    else check "plugin:$p" info 0 "$p is not in the $MARKETPLACE marketplace's folder" "claude plugin marketplace update $MARKETPLACE"; fi
    local where; where="$(jq -r --arg id "$p@$MARKETPLACE" '(.plugins[$id] // [])[] | "\(.scope)\(if .projectPath then " " + .projectPath else "" end)"' "$ip" 2>/dev/null | paste -sd ';' -)"
    [ -z "$where" ] || check "plugin:$p:installed" warn 0 \
      "$p is installed ($where), but it loads on demand: an installed copy can stop the launcher's from loading" \
      "! claude plugin uninstall $p@$MARKETPLACE --scope <scope>   (run in the folder named, for a local install)"
  done
  if [ "$(jq -r --arg m "$MARKETPLACE" '.enabledPlugins["ks-agent-limit@"+$m] // false' "$SETTINGS" 2>/dev/null)" = true ] \
    || [[ " ${KS_EXTRA_PLUGINS:-$(ksc_get KS_EXTRA_PLUGINS 2>/dev/null)} " == *" ks-agent-limit "* ]]; then
    check plugin:ks-agent-limit warn 0 "ks-agent-limit is enabled, but it is disabled and unmaintained" \
      "claude plugin disable ks-agent-limit@$MARKETPLACE  (and drop it from KS_EXTRA_PLUGINS)"
  fi

  if [ -d "$KS_ROOT_DIR/scripts/node_modules/tsx" ]; then check deps error 1 "ks CLI dependencies installed"
  else check deps error 0 "ks CLI dependencies missing ($KS_ROOT_DIR/scripts/node_modules)" "cd $KS_ROOT_DIR/scripts && npm ci   (installed plugins: start a new session)"; fi

  local proj; proj="$(ksc_project_root 2>/dev/null || true)"
  if [ -n "$proj" ] && [ -d "$proj" ]; then check config:KS_PROJECT_ROOT_PATH error 1 "project: $proj ($(ksc_source KS_PROJECT_ROOT_PATH))"
  else check config:KS_PROJECT_ROOT_PATH error 0 "KS_PROJECT_ROOT_PATH is not set" "ks-config set ks.KS_PROJECT_ROOT_PATH <karmasuite checkout>"; fi
  local k ns src
  for k in LINEAR_API_KEY:error SLACK_TOKEN:warn GRAIN_API_TOKEN:info; do
    lvl="${k#*:}"; k="${k%%:*}"; ns="$(ksc_ns "$k")"; src="$(ksc_source "$k")"
    case "$src" in
      unset) check "config:$k" "$lvl" 0 "$k is not set" "! ks-config secret $ns.$k" ;;
      legacy) check "config:$k" info 1 "$k set in a legacy file" "ks-config import-legacy   (moves it to the Keychain)" ;;
      *) check "config:$k" "$lvl" 1 "$k set ($src)" ;;
    esac
  done

  # The copy the KS commands run here (ksr_live_root, as the shims resolve it) against
  # the one Claude loads in the checkout (installed_root). They differ when this
  # folder's install (a worktree's) is behind the checkout's, or KS_ROOT_* points elsewhere.
  local rp lr ir drift=()
  for rp in ks ks-flow ks-master ks-browser; do
    lr="$(ksr_live_root "$rp" 2>/dev/null || true)"; ir="$(installed_root "$rp")"
    [ -n "$lr" ] && [ -n "$ir" ] && [ "$lr" != "$ir" ] && [ "$(plugin_version "$lr")" != "$(plugin_version "$ir")" ] \
      && drift+=("$rp $(plugin_version "$lr") (Claude loads $(plugin_version "$ir"))")
  done
  if [ ${#drift[@]} = 0 ]; then check plugins:copies info 1 "the KS commands run the copies Claude loads"
  else check plugins:copies warn 0 "the KS commands here run another copy than Claude loads in the checkout: ${drift[*]}" "ks-setup update"; fi

  # Token files must not sit in a plugin folder: a marketplace install copies the
  # whole folder (gitignored files included) into ~/.claude/plugins/cache.
  local leaks=() lf
  for p in ks ks-flow ks-master ks-browser; do
    root="$(ks_root "$p" 2>/dev/null)" || continue
    while IFS= read -r lf; do leaks+=("$lf"); done < <(find "$root" -maxdepth 3 -name '.env*' ! -name '*.example' -not -path '*/node_modules/*' 2>/dev/null)
  done
  while IFS= read -r lf; do leaks+=("$lf"); done < <(find "$HOME/.claude/plugins/cache/$MARKETPLACE" -name '.env*' ! -name '*.example' -not -path '*/node_modules/*' 2>/dev/null)
  if [ ${#leaks[@]} = 0 ]; then check secrets:files error 1 "no token files in plugin folders or the plugin cache"
  else check secrets:files error 0 "token files in plugin folders or cache: ${leaks[*]}" "move the tokens to the Keychain (ks-config import-legacy --from <file>), then delete these files"; fi
  local missing=() s cmd
  for s in "${SHIMS[@]}"; do cmd="${s#*:}"; [ -x "$LOCAL_BIN/$cmd" ] || have "$cmd" || missing+=("$cmd"); done
  if [ ${#missing[@]} = 0 ]; then check path warn 1 "every KS command is on PATH"
  else check path warn 0 "not on PATH: ${missing[*]}" "ks-setup apply"; fi
  case ":$PATH:" in *":$LOCAL_BIN:"*) ;; *)
    [ -d "$LOCAL_BIN" ] && check path:local-bin info 0 "$LOCAL_BIN is not on this shell's PATH" "ks-setup apply   (adds it to $(rc_file 2>/dev/null || echo 'your shell rc'))" ;;
  esac

  local ex miss=()
  if sandbox_enabled; then
    while read -r ex; do [ -n "$ex" ] && ! is_excluded "$ex" && miss+=("$ex"); done < <(want_excluded)
    if [ ${#miss[@]} = 0 ]; then check sandbox warn 1 "sandbox excludes every KS command$(flow_enabled || echo ' (ks-flow is not enabled, so its entry is not needed)')"
    elif is_excluded "$SELF_EXCLUDED"; then
      check sandbox warn 0 "sandbox does not exclude: ${miss[*]}" "ks-setup claude-settings --yes   (Claude runs it once you agree)"
    else check sandbox warn 0 "sandbox does not exclude: ${miss[*]}" "! ks-setup claude-settings --self, then ks-setup claude-settings --yes"; fi
  else
    check sandbox info 1 "sandbox off: no commands need excluding"
  fi
  local dn dmiss=()
  for dn in "${DENY[@]}"; do
    jq -e --arg r "$dn" '(.permissions.deny // []) | index($r) != null' "$SETTINGS" >/dev/null 2>&1 || dmiss+=("$dn")
  done
  if [ ${#dmiss[@]} = 0 ]; then check secrets:deny warn 1 "the agent may not run security (Keychain reads)"
  else check secrets:deny warn 0 "the agent may run security and read the KS tokens (missing deny: ${dmiss[*]})" "$(cs_fix)"; fi

  local flow; flow="$(ks_root ks-flow 2>/dev/null)"
  if [ -n "$flow" ] && [ -n "$proj" ]; then
    local dd; dd="$(node "$flow/src/lib/datadir.mjs" --project "$proj" 2>/dev/null)"
    if [ -n "$dd" ] && [ -f "$dd/project.conf" ]; then check ks-flow:data info 1 "ks-flow data $dd"
    else check ks-flow:data warn 0 "ks-flow has not set up $proj yet" "start a Claude session in it, or: ks-flow set-project $proj"; fi
    local dbp="" cred="" fmode="" gproj=""
    if [ -n "$dd" ]; then
      dbp="$(ksc_file_value DB_PROVIDER "$dd/.env" 2>/dev/null || true)"
      cred="$(ksc_file_value FIRESTORE_CREDENTIALS "$dd/.env" 2>/dev/null || true)"
      fmode="$(ksc_file_value FIRESTORE_MODE "$dd/.env" 2>/dev/null || true)"
      gproj="$(ksc_file_value FIREBASE_PROJECT_ID "$dd/.env" 2>/dev/null || true)"
    fi
    # The same choice the daemon makes (ks-flow src/lib/config.ts resolveDbProvider):
    # an explicit DB_PROVIDER wins; else Firestore when a cloud project is set.
    local how="DB_PROVIDER"
    if [ -z "$dbp" ]; then
      how="auto"
      if [ "$fmode" = cloud ] && [ -n "$gproj" ]; then dbp=firestore; else dbp=pocketbase; fi
    fi
    if [ "$dbp" = firestore ]; then check ks-flow:store info 1 "ks-flow store: firestore${gproj:+ (project $gproj)} [$how]"
    else check ks-flow:store info 1 "ks-flow store: $dbp [$how]"; fi
    if [ "$dbp" = firestore ] && [ -n "$cred" ] && [ ! -r "$cred" ]; then
      check ks-flow:firestore-key error 0 "Firestore key $cred is not readable" "ks-setup store firestore --project <id> --credentials <key.json>"
    fi
    if launchctl print "gui/$(id -u)/com.ksflow.ingester" >/dev/null 2>&1; then check ks-flow:daemon warn 1 "ks-flow daemon loaded"
    else check ks-flow:daemon warn 0 "ks-flow daemon not loaded" "ks-flow start"; fi
    device_check "$flow" "$dd" "$dbp"
    version_check "$dd"
  fi
  if have tmux && { [ -d /Applications/Ghostty.app ] || [ -d /System/Applications/Utilities/Terminal.app ]; }; then
    check master info 1 "master can run (tmux + a viewer app)"
  else check master info 0 "the master needs tmux and Ghostty or Terminal.app" "ks-setup tools --yes tmux"; fi
  if [ "$(jq -r '.env.KS_MOD_STATUSLINE // empty' "$SETTINGS" 2>/dev/null)" = 1 ]; then check settings:statusline info 1 "statusline split for the ks mod"
  else check settings:statusline info 0 "env KS_MOD_STATUSLINE not set (only claude-ks set it)" "$(cs_fix)"; fi
  statusline_check
  remote_control_check

  local all; all="$(printf '%s\n' "${CHECKS[@]}" | jq -s --arg mode "$mode" \
    '{mode:$mode, errors:(map(select(.level=="error" and (.ok|not)))|length), checks:.}')"
  if [ "$json" = 1 ]; then printf '%s\n' "$all"
  else
    printf '%s\n' "$all" | jq -r '"load mode: \(.mode)", (.checks[] |
      (if .ok then "  ok   " elif .level=="error" then "  ERR  " elif .level=="warn" then "  warn " else "  info " end)
      + .message + (if (.ok|not) and .fix then "\n         → " + .fix else "" end))'
  fi
  [ "$(printf '%s' "$all" | jq '.errors')" = 0 ]
}

# ── status line (optional) ──────────────────────────────────────────────────
# The status line Claude uses in the KS project: its own .claude/settings.local.json,
# then .claude/settings.json, then ~/.claude/settings.json (the first that sets one).
effective_statusline() {
  local proj f c
  proj="$(ksc_project_root 2>/dev/null || true)"
  for f in ${proj:+"$proj/.claude/settings.local.json" "$proj/.claude/settings.json"} "$SETTINGS"; do
    c="$(jq -r '.statusLine.command // empty' "$f" 2>/dev/null)"
    [ -n "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}
# Ours: the shim, the plugin's bin/statusline, or a command that starts with `statusline`.
is_ks_statusline() { case "$1" in "$STATUSLINE_CMD"*|*/.local/bin/statusline*|statusline|statusline\ *|*/plugins/ks/*statusline*) return 0 ;; esac; return 1; }
statusline_check() {
  local c; c="$(effective_statusline || true)"
  if [ -n "$c" ] && is_ks_statusline "$c"; then check statusline:project info 1 "KS status line on in the project"
  elif [ -n "$c" ]; then check statusline:project info 0 "the project uses another status line ($c); the KS one is optional" "ks-setup statusline --yes"
  else check statusline:project info 0 "no status line in the project; the KS one is optional" "ks-setup statusline --yes"; fi
}

statusline_settings() {
  [ "${1:-}" = --yes ] && YES=1
  local proj; proj="$(ksc_project_root 2>/dev/null)" \
    || { say "The KarmaSuite checkout isn't set: ks-config set ks.KS_PROJECT_ROOT_PATH <path>"; return 1; }
  local f="$proj/.claude/settings.local.json"
  local want; want="$(jq -nc --arg c "$STATUSLINE_CMD" '{type:"command", command:$c}')"
  local cur; cur="$(jq -c '.statusLine // empty' "$f" 2>/dev/null)"
  [ -x "$LOCAL_BIN/statusline" ] || say "Note: $LOCAL_BIN/statusline is missing; ks-setup apply writes it."
  if [ "$cur" = "$want" ]; then
    say "$f already has the KS status line"
  else
    say "To set in $f (this checkout and its worktrees only):"
    say "  statusLine: $want"
    [ -n "$cur" ] && say "  replacing: $cur"
    local user; user="$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null)"
    [ -n "$user" ] && say "  (your ~/.claude/settings.json status line, $user, stays for every other folder)"
    if ! ask "Apply?"; then
      interactive || say "Once you agree:  ks-setup statusline --yes"
      return 1
    fi
    mkdir -p "$proj/.claude"; [ -f "$f" ] || echo '{}' >"$f"
    jq --argjson s "$want" '.statusLine = $s' "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f" && say "updated $f"
  fi
  sync_worktree_plugins
  say "Applies to new Claude sessions in the checkout."
}

# ── Remote Control in the project (optional; suggested from 2 devices) ─────
# Claude honours remoteControlAtStartup=true only in user or managed settings,
# never in a project's own (a repo can't switch it on), so the project-only way
# is a `claude` shell function that adds --rc when the folder belongs to the
# configured KarmaSuite checkout's repository (the main checkout or any
# worktree). Remote Control sessions on your other Macs can then message each
# other (/peers, SendMessage).
rc_block() {
  printf '%s\n' "$RC_BEGIN"
  cat <<'BLOCK'
# Claude in the KarmaSuite checkout (ks.KS_PROJECT_ROOT_PATH) and its worktrees
# starts with Remote Control, so agents on your other Macs can message it.
# Subcommands (claude plugin ...) are left alone.
claude() {
  if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
    local proj here there
    proj="$(ks-config get ks.KS_PROJECT_ROOT_PATH 2>/dev/null)"
    if [ -n "$proj" ]; then
      here="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
      there="$(git -C "$proj" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
      if [ -n "$here" ] && [ "$here" = "$there" ]; then command claude --rc "$@"; return; fi
    fi
  fi
  command claude "$@"
}
BLOCK
  printf '%s\n' "$RC_END"
}
rc_has_block() { [ -f "$1" ] && grep -qF "$RC_BEGIN" "$1"; }
rc_current_block() { awk -v b="$RC_BEGIN" -v e="$RC_END" '$0==b{p=1} p{print} p&&$0==e{p=0}' "$1"; }
rc_strip_block() { # file → stdout without the block (and the blank line written before it)
  awk -v b="$RC_BEGIN" -v e="$RC_END" '
    $0==b { skip=1; blank=0; next }
    skip { if ($0==e) skip=0; next }
    $0=="" { if (blank) print ""; blank=1; next }
    { if (blank) print ""; blank=0; print }
    END { if (blank) print "" }' "$1"
}
# On: the block in the shell's startup file, or Remote Control for every session.
remote_control_on() {
  local rc; rc="$(rc_file 2>/dev/null)" && rc_has_block "$rc" && return 0
  [ "$(jq -r '.remoteControlAtStartup // empty' "$SETTINGS" 2>/dev/null)" = true ]
}
many_devices() { [ -n "$DEVICE_COUNT" ] && [ "$DEVICE_COUNT" -ge 2 ] 2>/dev/null; }
remote_control_reason() {
  if many_devices; then echo "$DEVICE_COUNT devices share the ks-flow board"
  else echo "optional with one Mac"; fi
}
remote_control_check() {
  if remote_control_on; then
    check remote-control info 1 "Remote Control on for Claude in the project (agents can message across machines)"
  elif many_devices; then
    check remote-control warn 0 "$DEVICE_COUNT devices share the ks-flow board, but Claude in the project starts without Remote Control, so agents on different Macs can't message each other" "ks-setup remote-control --yes"
  else
    check remote-control info 0 "Remote Control for the project is off (optional with one Mac; suggested once a second Mac shares the board)" "ks-setup remote-control --yes"
  fi
}
remote_control_settings() {
  local remove=0 a rc
  for a in "$@"; do case "$a" in --yes) YES=1 ;; --remove) remove=1 ;; esac; done
  if ! rc="$(rc_file)"; then
    say "Couldn't tell your shell (SHELL=${SHELL:-unset}). Add this to its startup file:"; rc_block; return 1
  fi
  if [ "$remove" = 1 ]; then
    rc_has_block "$rc" || { say "$rc has no ks remote-control block"; return 0; }
    rc_strip_block "$rc" >"$rc.tmp.$$" && mv "$rc.tmp.$$" "$rc" && say "removed the block from $rc (open a new terminal)"
    return 0
  fi
  ksc_project_root >/dev/null 2>&1 \
    || say "Note: the KarmaSuite checkout isn't set yet (ks-config set ks.KS_PROJECT_ROOT_PATH <path>); until it is, the function does nothing."
  if rc_has_block "$rc"; then
    [ "$(rc_current_block "$rc")" = "$(rc_block)" ] && { say "$rc already has it"; return 0; }
    say "To update the ks remote-control block in $rc"
  else
    say "To add to $rc: a \`claude\` function that starts Claude with --rc (Remote Control)"
    say "in the KarmaSuite checkout and its worktrees only; every other folder is unchanged."
    say "Remote Control keeps those sessions' transcripts on Anthropic's servers; commands still run only here."
  fi
  if ! ask "Apply?"; then
    interactive || say "Once you agree:  ks-setup remote-control --yes"
    return 1
  fi
  { if [ -f "$rc" ]; then rc_strip_block "$rc"; fi; printf '\n'; rc_block; } >"$rc.tmp.$$" && mv "$rc.tmp.$$" "$rc" \
    && say "updated $rc (open a new terminal, or: source $rc)"
}

# ── versions ────────────────────────────────────────────────────────────────
# Three copies of a plugin can differ: the one the KS commands run (ksr_live_root in
# lib/ks-root.sh, as the shims resolve it), the one Claude loads in the
# KarmaSuite checkout (its install), and the newest the karmasuite marketplace
# offers (as of its last update). ks-flow adds its daemon's and the store's.
plugin_version() { jq -r '.version // empty' "$1/.claude-plugin/plugin.json" 2>/dev/null; }
claude_plugins_dir() { printf '%s/plugins' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; }
# installed_plugins.json's entries for <plugin>@karmasuite, one JSON object per line
# ({scope, projectPath?, installPath, version, ...}; v2: an array per id).
ip_entries() {
  jq -c --arg id "$1@$MARKETPLACE" '.plugins[$id] // empty | if type == "array" then .[] else . end | objects' \
    "$(claude_plugins_dir)/installed_plugins.json" 2>/dev/null
}
# The version of one entry (scope + projectPath) now, re-read from the file.
ip_entry_version() { # plugin scope projectPath
  ip_entries "$1" | jq -r --arg s "$2" --arg pp "$3" 'select(.scope == $s and (.projectPath // "") == $pp) | .version // empty' 2>/dev/null | head -1
}
# The folder Claude loads <plugin> from for the KarmaSuite checkout, read from
# Claude's own files (never spawns `claude`): a directory marketplace, the
# clone's folder; else the checkout's installed_plugins.json entry
# (local/project), else a user/managed one, highest version first; else empty.
installed_root() {
  local n="$1" proj d l
  proj="$(ksc_project_root 2>/dev/null || true)"; proj="${proj%/}"
  d="$(jq -r --arg m "$MARKETPLACE" '.[$m] | objects | select(.source.source? == "directory") | (.installLocation // .source.path) // empty' \
    "$(claude_plugins_dir)/known_marketplaces.json" 2>/dev/null)"
  if [ -n "$d" ]; then
    d="${d%/}/plugins/$n"
    if [ -d "$d" ] && [ "$(ksr_declared_name "$d")" = "$n" ]; then printf '%s' "$d"; return 0; fi
  fi
  while IFS= read -r l; do
    [ -n "$l" ] && [ -d "$l" ] && { printf '%s' "$l"; return 0; }
  done < <(ip_entries "$n" | jq -rs --arg p "$proj" '
    map(select(.installPath | type == "string")
        | .r = (if $p != "" and ((.projectPath // "") | rtrimstr("/")) == $p then 0
                elif .scope == "user" or .scope == "managed" then 1 else empty end))
    | sort_by(.r, ([.version // "0" | tostring | splits("[.+-]") | tonumber? // 0] | map(-.)))
    | .[].installPath' 2>/dev/null)
  return 0
}
marketplace_dir() { jq -r --arg m "$MARKETPLACE" '.[$m].installLocation // empty' "$(claude_plugins_dir)/known_marketplaces.json" 2>/dev/null; }
# plugin → the version the marketplace offers (as of its last refresh): the
# plugin.json in its source folder (what an install records), else the version
# its marketplace.json lists.
marketplace_version() {
  local d src v=""; d="$(marketplace_dir)"; [ -n "$d" ] || return 0
  src="$(jq -r --arg n "$1" '.plugins[]? | select(.name == $n) | .source | strings' "$d/.claude-plugin/marketplace.json" 2>/dev/null | head -1)"
  case "$src" in ./*|../*) v="$(plugin_version "$d/${src#./}")" ;; esac
  [ -n "$v" ] || v="$(jq -r --arg n "$1" '.plugins[]? | select(.name == $n) | .version // empty' "$d/.claude-plugin/marketplace.json" 2>/dev/null | head -1)"
  printf '%s' "$v"
}
ver_lt() { [ -n "$1" ] && [ -n "$2" ] && [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$1" ]; }
# <installed> needs <latest>: older, or not a version at all.
ver_behind() { [ -n "$2" ] && [ "$1" != "$2" ] && { ! [[ "$1" =~ ^[0-9] ]] || ver_lt "$1" "$2"; }; }

versions() {
  local json=0 a p reg inst cmdv clv latest rows=() dd vs
  for a in "$@"; do [ "$a" = --json ] && json=1; done
  for p in ks ks-flow ks-master ks-browser; do
    reg="$(ksr_live_root "$p" 2>/dev/null || true)" # what the shims run
    inst="$(installed_root "$p")"
    cmdv="$([ -n "$reg" ] && plugin_version "$reg")"
    clv="$([ -n "$inst" ] && plugin_version "$inst")"
    latest="$(marketplace_version "$p")"
    local state="up to date" fix=""
    if [ -z "$inst" ] && [ -z "$reg" ]; then state="not installed"
    elif [ -n "$inst" ] && ver_lt "$clv" "$latest"; then state="Claude loads $clv, the marketplace has $latest"; fix="ks-setup update"
    elif [ -n "$inst" ] && [ "$reg" != "$inst" ] && [ "$cmdv" != "$clv" ]; then state="the commands run $cmdv, Claude loads $clv"; fix="ks-setup update"
    fi
    rows+=("$(jq -nc --arg p "$p" --arg c "$cmdv" --arg cr "$reg" --arg l "$clv" --arg lr "$inst" --arg m "$latest" --arg s "$state" --arg f "$fix" \
      '{plugin:$p, commands:{version:$c, root:$cr}, claude:{version:$l, root:$lr}, marketplace:$m, state:$s, fix:(if $f=="" then null else $f end)}')")
  done
  # ks-flow's daemon and the shared store (version-status.json, written by the daemon).
  local flow; flow="$(ks_root ks-flow 2>/dev/null || true)"
  dd=""; [ -n "$flow" ] && dd="$(ksc_project_root >/dev/null 2>&1 && node "$flow/src/lib/datadir.mjs" --project "$(ksc_project_root)" 2>/dev/null || true)"
  vs='null'; [ -n "$dd" ] && [ -f "$dd/version-status.json" ] && vs="$(jq -c '{daemon:.version, store:.storeVersion, schema:.schemaVersion, storeSchema:.storeSchemaVersion, dev:.dev, devReason:.devReason, behind:(.versionBehind or .schemaBehind), update:.update.state}' "$dd/version-status.json" 2>/dev/null || echo null)"
  local mdate; mdate="$(jq -r --arg m "$MARKETPLACE" '.[$m].lastUpdated // empty' "$(claude_plugins_dir)/known_marketplaces.json" 2>/dev/null)"
  local all; all="$(printf '%s\n' "${rows[@]}" | jq -s --argjson f "$vs" --arg md "$mdate" --arg mode "$(load_mode)" \
    '{mode:$mode, marketplaceUpdated:$md, plugins:., ksFlow:$f}')"
  if [ "$json" = 1 ]; then printf '%s\n' "$all"; return 0; fi
  printf '%s\n' "$all" | jq -r '"load mode: \(.mode)" + (if .marketplaceUpdated != "" then "   (marketplace last updated \(.marketplaceUpdated[0:16] | sub("T"; " ")))" else "" end)'
  echo
  printf '%s\n' "$all" | jq -r '
    (["plugin", "commands", "Claude", "marketplace", "state"] | @tsv),
    (.plugins[] | [ .plugin, (.commands.version // "" | if . == "" then "-" else . end), (.claude.version // "" | if . == "" then "-" else . end),
                    (.marketplace // "" | if . == "" then "-" else . end),
                    (if .state == "up to date" then "ok" else "\(.state)" + (if .fix then "  → \(.fix)" else "" end) end) ] | @tsv)' \
    | column -t -s $'\t'
  echo
  printf '%s\n' "$all" | jq -r '
    if .ksFlow then
      "ks-flow daemon \(.ksFlow.daemon // "?"), store \(.ksFlow.store // "?") (data format \(.ksFlow.schema // "?")\(if .ksFlow.storeSchema and .ksFlow.storeSchema != .ksFlow.schema then " vs store \(.ksFlow.storeSchema)" else "" end))"
        + ((.plugins[] | select(.plugin == "ks-flow") | .claude.version // "") as $cv
           | if $cv != "" and .ksFlow.daemon and $cv != .ksFlow.daemon then "  the daemon runs \(.ksFlow.daemon), Claude has \($cv) → ks-flow stop && ks-flow start" else "" end)
        + (if .ksFlow.behind then "  BEHIND → ks-flow update (the daemon also runs it itself, at most hourly)" else "" end)
        + (if .ksFlow.dev then "  [dev build: \(.ksFlow.devReason // "not a release")]" else "" end)
        + (if (.ksFlow.update // "") == "failed" then "  last update failed (see update.log)" else "" end)
    else "ks-flow: no version yet (the daemon writes it on start)" end'
}

# ── update ──────────────────────────────────────────────────────────────────
# `ks-setup update [--check] [--no-restart] [--json] [--auto]`: every KS plugin
# on this machine to the newest release, the way `plannotator update` does it:
# one run at a time (${KS_CONFIG_DIR}/update.lock: a folder holding pid and
# startedAt; stale when its pid is gone or after 2 h), logged to
# ${KS_CONFIG_DIR}/update.log.
#   installed (the folder the commands run is in the plugin cache):
#     `claude plugin marketplace update karmasuite`, then for ks-suite, ks,
#     ks-flow, ks-master and ks-browser, each installed_plugins.json entry
#     behind the marketplace: `claude plugin update <p>@karmasuite --scope
#     <scope> --json`, run IN the entry's projectPath (`--scope local` resolves
#     from the cwd; one entry per worktree). A worktree that is gone is skipped,
#     a managed entry too; entries are never created.
#   a clone (a directory marketplace, KS_ROOT_*, --plugin-dir): only on branch
#     main with no uncommitted changes to tracked files (else refused), then
#     `git pull --ff-only`.
#   then the NEW copy's `ks-setup shims`, and (not with --no-restart) when
#     ks-flow changed, `ks-flow update --no-fetch` (rebuild, restart; no browser).
# --check fetches (the marketplace refresh / `git fetch`) and installs nothing.
# --json: the lines for a person go to stderr; stdout gets one JSON object:
#   {state: updated|current|available|refused|failed|busy, mode: marketplace|clone|null,
#    plugins: [{plugin, from, to, projects: [{path, scope, from, to, ok}]}],
#    reason: string|null, log: <update.log>, by: manual|auto, restarted: bool}
#   (projects: the installs, marketplace mode only; ok = at the newest now.)
# Exit: 0 updated / current / available, 1 refused / failed, 2 usage, 3 busy.
UPD_PLUGINS=(ks-suite ks ks-flow ks-master ks-browser)
U_JSON=0 U_LOG="" U_LOCK="" U_STATE="" U_MODE="" U_REASON="" U_PLUG="" U_PROJ="" U_CHANGED=0 U_FLOW_CHANGED=0 U_FAILS=""
U_CLAUDE="${KS_CLAUDE_BIN:-claude}"

ulog() { # a line for the person (stderr with --json) and update.log
  printf '[%s] [ks-setup update] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$U_LOG" 2>/dev/null
  if [ "$U_JSON" = 1 ]; then printf '%s\n' "$*" >&2; else printf '%s\n' "$*"; fi
}
ulog_out() { # a command's output: update.log only, indented
  [ -n "$1" ] && printf '%s\n' "$1" | sed 's/^/    /' >>"$U_LOG" 2>/dev/null
  return 0
}
u_tail() { printf '%s' "$1" | tail -3 | tr '\n' ' ' | sed 's/ *$//' | cut -c1-300; }
u_fail() { U_FAILS="${U_FAILS:+$U_FAILS; }$*"; }

# Take update.lock. 1 = held by a live run (its pid alive and under 2 h old).
update_lock() {
  local l="$U_LOCK" pid i
  mkdir -p "$(dirname "$l")" 2>/dev/null
  for i in 1 2; do
    if mkdir "$l" 2>/dev/null; then
      printf '%s\n' "$$" >"$l/pid"; date -u +%Y-%m-%dT%H:%M:%SZ >"$l/startedAt"
      return 0
    fi
    pid="$(cat "$l/pid" 2>/dev/null)"
    if [ -z "$pid" ]; then
      # Just taken, its pid not written yet: held, unless it is old.
      [ -n "$(find "$l" -maxdepth 0 -mmin -1 2>/dev/null)" ] && return 1
    elif kill -0 "$pid" 2>/dev/null && [ -z "$(find "$l/pid" -mmin +120 2>/dev/null)" ]; then
      return 1
    fi
    ulog "a stale update lock (pid ${pid:-none}, started $(cat "$l/startedAt" 2>/dev/null || echo '?')) was released"
    rm -rf "$l"
  done
  return 1
}
update_unlock() { [ "$(cat "$U_LOCK/pid" 2>/dev/null)" = "$$" ] && rm -rf "$U_LOCK"; return 0; }

u_plug() { # plugin from to
  U_PLUG="$U_PLUG$(jq -nc --arg p "$1" --arg f "$2" --arg t "$3" '{plugin:$p, from:(if $f == "" then null else $f end), to:(if $t == "" then null else $t end)}')"$'\n'
}
u_proj() { # plugin path scope from to ok(true|false)
  U_PROJ="$U_PROJ$(jq -nc --arg p "$1" --arg d "$2" --arg s "$3" --arg f "$4" --arg t "$5" --argjson ok "$6" \
    '{plugin:$p, path:(if $d == "" then null else $d end), scope:$s, from:(if $f == "" then null else $f end), to:(if $t == "" then null else $t end), ok:$ok}')"$'\n'
}

update_marketplace() { # check(0|1)
  local check="$1" proj out rc p latest scope pp ver orig nv dir pfrom n any=0
  proj="$(ksc_project_root 2>/dev/null || true)"
  if ! command -v "$U_CLAUDE" >/dev/null 2>&1; then
    U_STATE=refused U_REASON="claude is not on PATH"; return
  fi
  ulog "refreshing the $MARKETPLACE marketplace"
  out="$(cd "${proj:-$HOME}" 2>/dev/null; "$U_CLAUDE" plugin marketplace update "$MARKETPLACE" </dev/null 2>&1)"; rc=$?
  ulog_out "$out"
  if [ "$rc" != 0 ]; then
    U_STATE=failed U_REASON="claude plugin marketplace update $MARKETPLACE failed (exit $rc)${out:+: $(u_tail "$out")}"; return
  fi
  for p in "${UPD_PLUGINS[@]}"; do
    latest="$(marketplace_version "$p")"
    pfrom="" n=0
    while IFS=$'\037' read -r scope pp ver; do
      case "$scope" in
        managed) ulog "$p: a managed install, not updated here"; continue ;;
        user) dir="$HOME" pp="" ;;
        local|project)
          if [ -z "$pp" ] || [ ! -d "$pp" ]; then ulog "$p: ${pp:-an install} is gone; skipped"; continue; fi
          dir="$pp" ;;
        *) continue ;;
      esac
      if [ -z "$latest" ]; then ulog "$p: the $MARKETPLACE marketplace doesn't offer it; skipped"; break; fi
      n=$((n + 1))
      if [ -z "$pfrom" ] || ver_lt "$ver" "$pfrom"; then pfrom="$ver"; fi
      if ! ver_behind "$ver" "$latest"; then u_proj "$p" "$pp" "$scope" "$ver" "$ver" true; continue; fi
      any=1
      if [ "$check" = 1 ]; then ulog "$p: $ver → $latest available in $dir ($scope)"; u_proj "$p" "$pp" "$scope" "$ver" "$latest" false; continue; fi
      # An earlier update (ks-suite brings its dependencies) may have done it already.
      orig="$ver"; ver="$(ip_entry_version "$p" "$scope" "$pp")"
      if ! ver_behind "$ver" "$latest"; then
        u_proj "$p" "$pp" "$scope" "$orig" "$ver" true
        U_CHANGED=1; [ "$p" = ks-flow ] && U_FLOW_CHANGED=1
        continue
      fi
      ulog "$p: $ver → $latest in $dir ($scope)"
      out="$(cd "$dir" && "$U_CLAUDE" plugin update "$p@$MARKETPLACE" --scope "$scope" --json </dev/null 2>&1)"; rc=$?
      ulog_out "$out"
      nv="$(ip_entry_version "$p" "$scope" "$pp")"
      [ "$nv" != "$orig" ] && { U_CHANGED=1; [ "$p" = ks-flow ] && U_FLOW_CHANGED=1; }
      if [ "$rc" = 0 ] && ! ver_behind "$nv" "$latest"; then
        u_proj "$p" "$pp" "$scope" "$orig" "$nv" true
      else
        u_proj "$p" "$pp" "$scope" "$orig" "$nv" false
        if [ "$rc" != 0 ]; then u_fail "$p in $dir: claude plugin update failed (exit $rc)${out:+: $(u_tail "$out")}"
        else u_fail "$p in $dir: still ${nv:-unknown} after the update, the marketplace has $latest"; fi
        ulog "$p in $dir: the update failed (see the log)"
      fi
    done < <(ip_entries "$p" | jq -r '[.scope // "", (.projectPath // "" | rtrimstr("/")), (.version // "" | tostring)] | join("\u001f")' 2>/dev/null)
    [ "$n" -gt 0 ] && u_plug "$p" "$pfrom" "$latest"
  done
  if [ -n "$U_FAILS" ]; then U_STATE=failed U_REASON="$U_FAILS"
  elif [ "$check" = 1 ]; then if [ "$any" = 1 ]; then U_STATE=available; else U_STATE=current; fi
  elif [ "$U_CHANGED" = 1 ]; then U_STATE=updated
  else U_STATE=current; fi
}

update_clone() { # root check(0|1)
  local root="$1" check="$2" repo br up out rc p f t head0 head1 any=0 plugs=()
  if ! repo="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null)" || [ -z "$repo" ]; then
    U_STATE=refused U_REASON="$root is neither an installed plugin nor a git clone"; return
  fi
  br="$(git -C "$repo" symbolic-ref --short -q HEAD 2>/dev/null)"
  if [ "$br" != main ]; then
    if [ -n "$br" ]; then U_STATE=refused U_REASON="the clone $repo is on branch $br, not main"
    else U_STATE=refused U_REASON="the clone $repo is not on a branch (detached HEAD)"; fi
    return
  fi
  if [ -n "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    U_STATE=refused U_REASON="the clone $repo has uncommitted changes"; return
  fi
  if ! up="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || [ -z "$up" ]; then
    U_STATE=refused U_REASON="main in $repo has no upstream branch to pull from"; return
  fi
  for p in "${UPD_PLUGINS[@]}"; do [ -f "$repo/plugins/$p/.claude-plugin/plugin.json" ] && plugs+=("$p"); done
  if [ "$check" = 1 ]; then
    ulog "fetching $up in $repo"
    out="$(git -C "$repo" fetch --quiet </dev/null 2>&1)"; rc=$?
    ulog_out "$out"
    if [ "$rc" != 0 ]; then U_STATE=failed U_REASON="git fetch failed (exit $rc)${out:+: $(u_tail "$out")}"; return; fi
    for p in ${plugs[@]+"${plugs[@]}"}; do
      f="$(plugin_version "$repo/plugins/$p")"
      t="$(git -C "$repo" show "$up:plugins/$p/.claude-plugin/plugin.json" 2>/dev/null | jq -r '.version // empty' 2>/dev/null)"
      [ -n "$t" ] || t="$f"
      ver_behind "$f" "$t" && { any=1; ulog "$p: $f → $t available"; }
      u_plug "$p" "$f" "$t"
    done
    if [ "$any" = 1 ]; then U_STATE=available; else U_STATE=current; fi
    return
  fi
  local before=() i=0
  for p in ${plugs[@]+"${plugs[@]}"}; do before+=("$(plugin_version "$repo/plugins/$p")"); done
  head0="$(git -C "$repo" rev-parse HEAD 2>/dev/null)"
  ulog "git pull --ff-only in $repo ($up)"
  out="$(git -C "$repo" pull --ff-only </dev/null 2>&1)"; rc=$?
  ulog_out "$out"
  if [ "$rc" != 0 ]; then U_STATE=failed U_REASON="git pull --ff-only failed (exit $rc)${out:+: $(u_tail "$out")}"; return; fi
  head1="$(git -C "$repo" rev-parse HEAD 2>/dev/null)"
  for p in ${plugs[@]+"${plugs[@]}"}; do
    t="$(plugin_version "$repo/plugins/$p")"
    u_plug "$p" "${before[$i]}" "$t"
    [ "${before[$i]}" != "$t" ] && ulog "$p: ${before[$i]} → $t"
    i=$((i + 1))
  done
  if [ "$head0" = "$head1" ]; then U_STATE=current; return; fi
  U_STATE=updated U_CHANGED=1
  git -C "$repo" diff --quiet "$head0" "$head1" -- plugins/ks-flow 2>/dev/null || U_FLOW_CHANGED=1
  ulog "pulled ${head0:0:7}..${head1:0:7}"
}

update_cmd() {
  local check=0 restart=1 by=manual a restarted=false
  for a in "$@"; do
    case "$a" in
      --check) check=1 ;; --no-restart) restart=0 ;; --json) U_JSON=1 ;; --auto) by=auto ;;
      *) echo "ks-setup update: unknown option $a (usage: ks-setup update [--check] [--no-restart] [--json] [--auto])" >&2; return 2 ;;
    esac
  done
  local cfg; cfg="$(ksc_dir)"
  mkdir -p "$cfg" 2>/dev/null
  U_LOG="$cfg/update.log" U_LOCK="$cfg/update.lock"
  if ! update_lock; then
    U_STATE=busy U_REASON="another update is running (pid $(cat "$U_LOCK/pid" 2>/dev/null || echo '?'), started $(cat "$U_LOCK/startedAt" 2>/dev/null || echo '?'))"
    ulog "$U_REASON"
    update_report "$by" false; return 3
  fi
  trap update_unlock EXIT
  ulog "start ($by$([ "$check" = 1 ] && echo ', check only'))"
  local root proj
  root="$(ksr_live_root ks 2>/dev/null)" || root="$KS_ROOT_DIR"
  proj="$(ksc_project_root 2>/dev/null || true)"
  case "$root" in
    "$(ksr_cache_dir)"*|"$HOME/.claude/plugins/cache/"*) U_MODE=marketplace; update_marketplace "$check" ;;
    *) U_MODE=clone; update_clone "$root" "$check" ;;
  esac

  if [ "$check" = 0 ] && [ "$U_CHANGED" = 1 ]; then
    # The shims as the NEW copy writes them (its ks-setup, not this one).
    local new out rc
    new="$(cd "${proj:-$PWD}" 2>/dev/null; ksr_live_root ks 2>/dev/null)" || new=""
    if [ -n "$new" ] && [ -x "$new/scripts/ks-setup" ]; then
      out="$(cd "${proj:-$PWD}" 2>/dev/null; "$new/scripts/ks-setup" shims </dev/null 2>&1)"; rc=$?
    else
      out="$(shims_refresh 2>&1)"; rc=$?
    fi
    ulog_out "$out"
    if [ "$rc" = 0 ]; then ulog "shims refreshed${new:+ from $new}"; else ulog "refreshing the shims failed (exit $rc): run ks-setup apply"; fi
    if [ "$restart" = 1 ] && [ "$U_FLOW_CHANGED" = 1 ]; then
      local flow; flow="$(cd "${proj:-$PWD}" 2>/dev/null; ksr_live_root ks-flow 2>/dev/null)" || flow=""
      if [ -n "$flow" ] && [ -x "$flow/bin/ks-flow" ]; then
        ulog "restarting ks-flow: ks-flow update --no-fetch"
        out="$(cd "${proj:-$PWD}" 2>/dev/null; KS_FLOW_NO_BROWSER=1 "$flow/bin/ks-flow" update --no-fetch </dev/null 2>&1)"; rc=$?
        ulog_out "$out"
        if [ "$rc" = 0 ]; then restarted=true
        else
          U_REASON="${U_REASON:+$U_REASON; }ks-flow update --no-fetch failed (exit $rc)${out:+: $(u_tail "$out")}"
          [ "$U_STATE" = updated ] && U_STATE=failed
        fi
      fi
    fi
  fi
  update_report "$by" "$restarted"
  case "$U_STATE" in updated|current|available) return 0 ;; *) return 1 ;; esac
}

update_report() { # by restarted
  local all
  all="$(jq -n --arg state "$U_STATE" --arg mode "$U_MODE" --arg reason "$U_REASON" --arg log "$U_LOG" --arg by "$1" \
    --argjson restarted "$2" \
    --argjson pl "$(printf '%s' "$U_PLUG" | jq -sc . 2>/dev/null || echo '[]')" \
    --argjson pr "$(printf '%s' "$U_PROJ" | jq -sc . 2>/dev/null || echo '[]')" '
    {state: $state, mode: (if $mode == "" then null else $mode end),
     plugins: [$pl[] | . as $p | . + {projects: [$pr[] | select(.plugin == $p.plugin) | del(.plugin)]}],
     reason: (if $reason == "" then null else $reason end), log: $log, by: $by, restarted: $restarted}')"
  local line
  line="$(jq -r '
    ([.plugins[] | select(.from != .to) | "\(.plugin) \(.from // "?") → \(.to // "?")"] | join(", ")) as $c
    | if .state == "updated" then "updated: \($c)" + (if .restarted then "; ks-flow restarted" else "" end)
      elif .state == "available" then "a new release: \($c) (install: ks-setup update)"
      elif .state == "current" then "every KS plugin is the newest release"
      else "\(.state): \(.reason // "")" end' <<<"$all")"
  ulog "done: $line"
  if [ "$U_STATE" = updated ] && [ "$U_JSON" = 0 ]; then
    if [ "$U_MODE" = clone ]; then say "Running sessions pick it up on /reload-plugins; new sessions start on it."
    else say "Running sessions keep the old copy until /reload-plugins or a restart; new sessions start on it."; fi
  fi
  [ "$U_JSON" = 1 ] && jq -c . <<<"$all"
  return 0
}

# ── apply ───────────────────────────────────────────────────────────────────
write_shim() { # plugin cmd: a self-contained shim (lib/ks-root.sh ksr_write_shim) that
  # finds the plugin's current folder on every run, never a baked-in versioned one
  ksr_write_shim "$1" "$2" "$LOCAL_BIN"
}
write_shims() { # resolver (ks_root, or ksr_live_root: never spawns claude)
  local s plug cmd root
  mkdir -p "$LOCAL_BIN"
  for s in "${SHIMS[@]}"; do
    plug="${s%%:*}"; cmd="${s#*:}"
    root="$("$1" "$plug" 2>/dev/null)" || continue
    [ -x "$root/bin/$cmd" ] && write_shim "$plug" "$cmd"
  done
  return 0
}

# `ks-setup shims` (quiet; `ks-setup update` runs it from the NEW copy): the
# shims as this version writes them, and the registry pruned to clone roots
# that still exist.
shims_refresh() {
  local p root reg tmp
  for p in ks ks-flow ks-master ks-browser; do
    root="$(ksr_live_root "$p" 2>/dev/null)" && ks_register_root "$p" "$root"
  done
  reg="$(ksr_registry)"
  if [ -s "$reg" ]; then
    local gone=() k
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      [ -d "$(jq -r --arg k "$k" '.[$k].root // empty' "$reg" 2>/dev/null)" ] || gone+=("$k")
    done < <(jq -r 'keys[]?' "$reg" 2>/dev/null)
    if [ ${#gone[@]} -gt 0 ]; then
      tmp="$reg.tmp.$$"
      jq --args 'delpaths([$ARGS.positional[] | [.]])' "${gone[@]}" <"$reg" >"$tmp" 2>/dev/null && mv "$tmp" "$reg" || rm -f "$tmp"
    fi
  fi
  write_shims ksr_live_root
}

add_path_line() {
  local rc line="export PATH=\"\$HOME/.local/bin:\$PATH\"  # KS plugins (ks-setup)"
  case ":$PATH:" in *":$LOCAL_BIN:"*) say "  PATH already has $LOCAL_BIN"; return ;; esac
  if ! rc="$(rc_file)"; then
    say "  Couldn't tell your shell (SHELL=${SHELL:-unset}). Add this to its startup file:"; say "    $line"; return
  fi
  if grep -qF '.local/bin' "$rc" 2>/dev/null; then say "  $rc already adds ~/.local/bin"; return; fi
  if { [ -e "$rc" ] && [ -w "$rc" ]; } || { [ ! -e "$rc" ] && [ -w "$(dirname "$rc")" ]; }; then
    if printf '\n%s\n' "$line" >>"$rc" 2>/dev/null; then say "  added ~/.local/bin to PATH in $rc (open a new terminal)"; return; fi
  fi
  say "  Couldn't write $rc. Run:"; say "    ! echo '$line' >> $rc"
}

# ── per-project plugins in worktrees ────────────────────────────────────────
# A --scope local install lives in the checkout's own .claude/settings.local.json,
# and a session in a worktree reads the worktree's copy. New worktrees get it from
# create-worktree; this copies the main checkout's `…@<marketplace>` enabledPlugins
# entries into every existing worktree of the project (other keys untouched).
sync_worktree_plugins() {
  local proj src ep wt f n=0
  proj="$(ksc_project_root 2>/dev/null)" || return 0
  src="$proj/.claude/settings.local.json"
  [ -f "$src" ] || return 0
  ep="$(jq -c --arg m "@$MARKETPLACE" '(.enabledPlugins // {}) | with_entries(select(.key|endswith($m)))' "$src" 2>/dev/null)"
  [ -n "$ep" ] || ep='{}'
  # The KS status line, when the checkout has it (ks-setup statusline), goes along.
  local sl; sl="$(jq -c '.statusLine // empty' "$src" 2>/dev/null)"
  [ -n "$sl" ] && ! is_ks_statusline "$(jq -r '.command // empty' <<<"$sl")" && sl=""
  [ "$ep" != "{}" ] || [ -n "$sl" ] || return 0
  say "== plugins in the project's worktrees"
  while read -r wt; do
    [ -n "$wt" ] && [ "$wt" != "$proj" ] && [ -d "$wt" ] || continue
    f="$wt/.claude/settings.local.json"
    if [ ! -f "$f" ]; then mkdir -p "$wt/.claude" && echo '{}' >"$f"; fi
    if jq -e --argjson ep "$ep" --argjson sl "${sl:-null}" \
      '((.enabledPlugins // {}) | contains($ep)) and ($sl == null or .statusLine == $sl)' "$f" >/dev/null 2>&1; then continue; fi
    jq --argjson ep "$ep" --argjson sl "${sl:-null}" \
      '.enabledPlugins = ((.enabledPlugins // {}) + $ep) | if $sl == null then . else .statusLine = $sl end' "$f" >"$f.tmp" \
      && mv "$f.tmp" "$f" && n=$((n + 1)) && say "  updated $wt"
  done < <(git -C "$proj" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  [ "$n" = 0 ] && say "  every worktree is up to date"
  return 0
}

apply() {
  local dev=0 a
  for a in "$@"; do case "$a" in --dev) dev=1 ;; --yes) YES=1 ;; esac; done
  local cfg; cfg="$(ksc_dir)"
  say "== KS config folder: $cfg"
  mkdir -p "$cfg" && chmod 700 "$cfg"
  [ -f "$cfg/ks.env" ] || { cp "$SCRIPT_DIR/ks.env.example" "$cfg/ks.env" 2>/dev/null && chmod 600 "$cfg/ks.env" && say "  created $cfg/ks.env"; }

  say "== plugin registry"
  local p root
  # The folder each plugin runs from now (lib/ks-root.sh: directory marketplace,
  # installed_plugins.json, ...). The registry keeps only clone (local) roots:
  # ks_register_root skips a plugin-cache folder and drops old marketplace entries.
  for p in ks ks-flow ks-master ks-browser; do
    root="$(ks_root "$p" 2>/dev/null)" || continue
    ks_register_root "$p" "$root"; say "  $p → $root ($(plugin_version "$root"))"
  done

  say "== commands on PATH ($LOCAL_BIN)"
  write_shims ks_root
  say "  shims written"
  add_path_line

  if [ ! -d "$KS_ROOT_DIR/scripts/node_modules/tsx" ]; then
    say "== ks CLI dependencies"
    if [ -w "$KS_ROOT_DIR/scripts" ]; then ( cd "$KS_ROOT_DIR/scripts" && npm ci --no-audit --no-fund ) || say "  npm ci failed"
    else say "  installed plugin: a new Claude session installs them (SessionStart)"; fi
  fi

  say "== project"
  if ! ksc_project_root >/dev/null 2>&1; then
    local pr=""
    if interactive; then read -rp "  Absolute path of your KarmaSuite checkout: " pr; fi
    if [ -n "$pr" ] && [ -d "$pr" ]; then "$SCRIPT_DIR/ks-config" set ks.KS_PROJECT_ROOT_PATH "$pr"
    else say "  not set. Run:  ks-config set ks.KS_PROJECT_ROOT_PATH <path>"; fi
  else say "  $(ksc_project_root)"; fi

  sync_worktree_plugins

  if "$SCRIPT_DIR/ks-config" import-legacy --dry-run 2>/dev/null | grep -q '^would'; then
    say "== legacy config (plugins/ks/scripts/.env, plugins/ks/.config)"
    "$SCRIPT_DIR/ks-config" import-legacy --dry-run
    if ask "  Move these into the Keychain / ~/.config/ks (old files stay)?"; then "$SCRIPT_DIR/ks-config" import-legacy
    else say "  Later:  ! ks-config import-legacy"; fi
  fi

  if [ "$dev" = 1 ]; then
    say "== load the clone as the $MARKETPLACE directory marketplace"
    local repo proj; repo="$(cd "$KS_ROOT_DIR/../.." && pwd)"
    proj="$(ksc_project_root 2>/dev/null || true)"
    # Per project, never user-wide: the plugins are switched on in the project's
    # own (gitignored) .claude/settings.local.json; new worktrees get it from
    # create-worktree, existing ones from sync_worktree_plugins.
    local cmd="cd ${proj:-<your KarmaSuite checkout>} && claude plugin marketplace add $repo && claude plugin install --scope local ks-suite@$MARKETPLACE"
    if [ "$(load_mode)" = dev-marketplace ]; then say "  already loaded from the clone"
    elif [ -n "$proj" ] && ask "  Run: $cmd ?"; then
      ( cd "$proj" && claude plugin marketplace add "$repo" && claude plugin install --scope local "ks-suite@$MARKETPLACE" ) \
        && say "  done: claude in $proj now loads ks + ks-flow from $repo (edits apply on /reload-plugins)" \
        && sync_worktree_plugins
    else
      say "  Run:  ! $cmd"
    fi
    say "  Then drop KS_EXTRA_PLUGINS:  ! ks-config unset ks.KS_EXTRA_PLUGINS"
  fi

  # Only what is still missing: the fixes of the doctor checks that fail.
  say "== next"
  local todo
  todo="$(doctor --json 2>/dev/null | jq -r '.checks[] | select((.ok|not) and .fix != null and .level != "info") | "  \(.fix)    (\(.message))"' 2>/dev/null)"
  if [ -n "$todo" ]; then printf '%s\n' "$todo"
  else say "  nothing left to do (details: ks-setup doctor)"; fi
  local opt=()
  is_ks_statusline "$(effective_statusline || true)" \
    || opt+=("  ks-setup statusline --yes    (the KS status line: session, context, branch, ticket, rate limits)")
  remote_control_on \
    || opt+=("  ks-setup remote-control --yes    (Remote Control in the project, so agents on your other Macs can message these; $(remote_control_reason))")
  if [ ${#opt[@]} -gt 0 ]; then say "== optional"; printf '%s\n' "${opt[@]}"; fi
}

# ── claude-settings ─────────────────────────────────────────────────────────
claude_settings() {
  local self=0 a
  for a in "$@"; do case "$a" in --yes) YES=1 ;; --self) self=1 ;; --ks-flow) WITH_FLOW=1 ;; esac; done
  [ -f "$SETTINGS" ] || { mkdir -p "$(dirname "$SETTINGS")"; echo '{}' >"$SETTINGS"; }
  if [ "$self" = 1 ]; then
    # The first step, which you run (`!`): only ks-setup, so Claude can run the rest.
    if is_excluded "$SELF_EXCLUDED"; then say "ks-setup is already excluded from the sandbox"; return 0; fi
    sandbox_enabled || say "Note: the sandbox is off, so this changes nothing until it is turned on."
    cp "$SETTINGS" "$SETTINGS.bak-ks"
    jq --arg c "$SELF_EXCLUDED" '.sandbox.excludedCommands = (((.sandbox.excludedCommands // []) + [$c, $c + " *"]) | unique)' \
      "$SETTINGS" >"$SETTINGS.tmp.$$" && mv "$SETTINGS.tmp.$$" "$SETTINGS" \
      && say "ks-setup excluded from the sandbox (backup: $SETTINGS.bak-ks). Claude can now run the rest of setup."
    return
  fi
  local want='[]'
  if sandbox_enabled; then
    want="$(want_excluded | jq -R . | jq -s 'map(select(. != "")) | map(., . + " *")')"
  fi
  local add; add="$(jq --argjson w "$want" '$w - (.sandbox.excludedCommands // [])' "$SETTINGS")"
  local dwant; dwant="$(printf '%s\n' "${DENY[@]}" | jq -R . | jq -s .)"
  local dadd; dadd="$(jq --argjson w "$dwant" '$w - (.permissions.deny // [])' "$SETTINGS")"
  local envset; envset="$(jq -r '.env.KS_MOD_STATUSLINE // empty' "$SETTINGS")"
  if [ "$(jq length <<<"$add")" = 0 ] && [ "$(jq length <<<"$dadd")" = 0 ] && [ "$envset" = 1 ]; then
    say "~/.claude/settings.json already has everything"; return 0
  fi
  say "To add to $SETTINGS:"
  [ "$(jq length <<<"$add")" = 0 ] || say "  sandbox.excludedCommands: $(jq -r 'join(", ")' <<<"$add")"
  [ "$(jq length <<<"$dadd")" = 0 ] || say "  permissions.deny: $(jq -r 'join(", ")' <<<"$dadd")  (the agent can't read the Keychain)"
  [ "$envset" = 1 ] || say "  env.KS_MOD_STATUSLINE = \"1\""
  sandbox_enabled || say "  (sandbox off: no commands to exclude)"
  if ! ask "Apply (a backup goes to settings.json.bak-ks)?"; then
    interactive || say "Once you agree:  ks-setup claude-settings --yes$([ "${WITH_FLOW:-0}" = 1 ] && echo ' --ks-flow')"
    return 1
  fi
  cp "$SETTINGS" "$SETTINGS.bak-ks"
  local tmp="$SETTINGS.tmp.$$"
  jq --argjson a "$add" --argjson d "$dadd" '(if ($a | length) > 0 then .sandbox.excludedCommands = ((.sandbox.excludedCommands // []) + $a) else . end)
     | .permissions.deny = ((.permissions.deny // []) + $d)
     | .env.KS_MOD_STATUSLINE = "1"' "$SETTINGS" >"$tmp" && mv "$tmp" "$SETTINGS" \
    && say "updated (backup: $SETTINGS.bak-ks)"
}

# ── tools (Homebrew) ────────────────────────────────────────────────────────
# The tools the doctor checks, installed with Homebrew after a yes. ks-setup is
# sandbox-excluded, so Claude can run this; it installs only these formulas.
TOOL_NAMES=(node npm git jq tmux terminal-notifier zstd ffmpeg gh)
tool_formula() { case "$1" in npm) echo node ;; *) echo "$1" ;; esac; }
tools_install() {
  local a want=() t f missing=()
  for a in "$@"; do case "$a" in --yes) YES=1 ;; -*) ;; *) want+=("$a") ;; esac; done
  [ ${#want[@]} -gt 0 ] || want=("${TOOL_NAMES[@]}")
  for t in "${want[@]}"; do
    case " ${TOOL_NAMES[*]} " in *" $t "*) ;; *) say "ks-setup tools: $t is not one of: ${TOOL_NAMES[*]}"; return 2 ;; esac
    f="$(tool_formula "$t")"
    if [ "$t" = node ] && have node \
      && ! node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>18||(a===18&&b>=17)?0:1)'; then
      missing+=("$f")   # too old: brew installs (or upgrades to) a current one
    elif ! have "$t"; then missing+=("$f"); fi
  done
  [ ${#missing[@]} -gt 0 ] || { say "every tool asked for is installed"; return 0; }
  missing=($(printf '%s\n' "${missing[@]}" | awk '!seen[$0]++'))
  if ! have brew; then
    say "Homebrew is missing. Install it from https://brew.sh (it asks for your password),"
    say "then run again. Needed: ${missing[*]}"
    return 1
  fi
  say "To install with Homebrew: ${missing[*]}"
  if ! ask "Install?"; then
    interactive || say "Once you agree:  ks-setup tools --yes ${missing[*]}"
    return 1
  fi
  brew install "${missing[@]}"
}

# ── store ───────────────────────────────────────────────────────────────────
set_env_line() { # file key value
  local tmp="$1.tmp.$$"
  { grep -v -E "^[[:space:]]*$2[[:space:]]*=" "$1" 2>/dev/null; printf '%s=%s\n' "$2" "$3"; } >"$tmp" && mv "$tmp" "$1"
  chmod 600 "$1"
}
store() {
  local kind="${1:-}"; shift || true
  local proj gcp="" cred=""
  while [ $# -gt 0 ]; do
    case "$1" in --project) shift; gcp="${1:-}" ;; --credentials) shift; cred="${1:-}" ;; esac
    shift
  done
  proj="$(ksc_project_root)" || { say "KS_PROJECT_ROOT_PATH is not set (ks-config set ks.KS_PROJECT_ROOT_PATH <path>)"; return 1; }
  local flow dd; flow="$(ks_root ks-flow)" || { say "ks-flow plugin not found"; return 1; }
  dd="$(node "$flow/src/lib/datadir.mjs" --project "$proj")" || return 1
  mkdir -p "$dd"; touch "$dd/.env"
  case "$kind" in
    pocketbase) set_env_line "$dd/.env" DB_PROVIDER pocketbase ;;
    firestore)
      [ -n "$gcp" ] && [ -n "$cred" ] || { say "usage: ks-setup store firestore --project <gcp id> --credentials <key.json>"; return 2; }
      [ -r "$cred" ] || { say "can't read $cred"; return 1; }
      set_env_line "$dd/.env" DB_PROVIDER firestore
      set_env_line "$dd/.env" FIRESTORE_MODE cloud
      set_env_line "$dd/.env" FIREBASE_PROJECT_ID "$gcp"
      set_env_line "$dd/.env" FIRESTORE_CREDENTIALS "$cred" ;;
    *) say "usage: ks-setup store pocketbase | firestore --project <gcp id> --credentials <key.json>"; return 2 ;;
  esac
  say "ks-flow store for $proj → $kind ($dd/.env). Restart:  ks-flow stop && ks-flow start && ks-flow open"
}

sub="${1:-doctor}"; [ $# -gt 0 ] && shift
case "$sub" in
  doctor) doctor "$@" ;;
  apply) apply "$@" ;;
  claude-settings|sandbox) claude_settings "$@" ;;
  store) store "$@" ;;
  statusline) statusline_settings "$@" ;;
  version|versions) versions "$@" ;;
  tools) tools_install "$@" ;;
  remote-control) remote_control_settings "$@" ;;
  update) update_cmd "$@" ;;
  shims) shims_refresh ;;
  -h|--help|help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0" ;;
  *) echo "ks-setup: unknown command $sub (try: ks-setup help)" >&2; exit 2 ;;
# `exit` on the same line as `esac`: `ks-setup update` may rewrite this file
# (git pull), and bash reads a script as it runs it.
esac; exit $?
