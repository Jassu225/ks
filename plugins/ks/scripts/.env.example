# Linear API Configuration
# Get your API key from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_your_key_here

# Slack API Configuration
# Get your token from: https://api.slack.com/apps
# Use a bot token (xoxb-) or user token (xoxp-)
# Scopes: chat:write, users:read, usergroups:read, channels:read, *:history
# (users:read and usergroups:read are what let plain @handles resolve into
#  real mentions; without them handles post as literal text and notify nobody)
SLACK_TOKEN=xoxp-your-token-here

# Grain API Configuration
# Generate a token from: https://grain.com/app/settings/integrations?tab=api
# Personal Access Token  -> sees only that user's recordings; the only token kind
#                           that supports `--attendance` and `-i private_notes`
# Workspace Access Token -> sees ALL workspace data (admin, Business/Enterprise);
#                           required for `grain recording upload --user-id`
GRAIN_API_TOKEN=your_grain_token_here
# GRAIN_STORAGE_DIR=~/Documents/Grain     # where `grain recording export` writes
# GRAIN_CRV_BIN=crv                       # claude-real-video binary for `recording watch`
# OAuth2 (only for building a distributable Grain integration — not needed for
# your own token). Keep the secret here, never on the command line:
# GRAIN_OAUTH_CLIENT_ID=
# GRAIN_OAUTH_CLIENT_SECRET=
# GRAIN_OAUTH_REFRESH_TOKEN=
# GRAIN_API_VERSION=2025-10-31            # API version header override
# GRAIN_API_BASE_URL=https://api.grain.com

# Extra local plugins to load alongside ks on every `claude-ks` launch.
# Space-separated plugins/<name> directories; missing dirs are warned and skipped.
# `plugins/ks-flow/init` sets this automatically.
# KS_EXTRA_PLUGINS="ks-flow"
