#!/bin/bash
set -e

DEV_MODE=false
while [[ "$#" -gt 0 ]]; do
  case $1 in
    --dev) DEV_MODE=true ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
  shift
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CSCRIPTS_DIR="$SCRIPT_DIR/c-scripts"

echo "=== Installing dependencies ==="
cd "$CSCRIPTS_DIR"
npm install

echo ""
echo "=== Building CLI tools ==="
npm run build

echo ""
echo "=== Configuring shell ==="
ZSHRC="$HOME/.zshrc"

# Add claude-ks alias (dev mode only)
if [ "$DEV_MODE" = true ]; then
  # Set dev=true in c-scripts/.env
  ENV_FILE="$CSCRIPTS_DIR/.env"
  if [ -f "$ENV_FILE" ]; then
    if grep -q "^DEV=" "$ENV_FILE" 2>/dev/null; then
      sed -i '' 's/^DEV=.*/DEV=true/' "$ENV_FILE"
    else
      echo "" >> "$ENV_FILE"
      echo "DEV=true" >> "$ENV_FILE"
    fi
  else
    echo "DEV=true" > "$ENV_FILE"
  fi
  echo "Set DEV=true in $ENV_FILE"
  PHASE_FILES_PATH="$SCRIPT_DIR/project-manager"
else
  PHASE_FILES_PATH="$HOME/.claude/plugins/ks/project-manager"
fi

# Set KS_PHASE_FILES_DIR in c-scripts/.env
ENV_FILE="${ENV_FILE:-$CSCRIPTS_DIR/.env}"
if [ -f "$ENV_FILE" ] && grep -q "^KS_PHASE_FILES_DIR=" "$ENV_FILE" 2>/dev/null; then
  sed -i '' "s|^KS_PHASE_FILES_DIR=.*|KS_PHASE_FILES_DIR=$PHASE_FILES_PATH|" "$ENV_FILE"
else
  # Ensure trailing newline before appending
  [ -s "$ENV_FILE" ] && [ -n "$(tail -c 1 "$ENV_FILE")" ] && echo "" >> "$ENV_FILE"
  echo "KS_PHASE_FILES_DIR=$PHASE_FILES_PATH" >> "$ENV_FILE"
fi
echo "Set KS_PHASE_FILES_DIR=$PHASE_FILES_PATH in $ENV_FILE"

# Add c-scripts to PATH
PATH_LINE="export PATH=\"$CSCRIPTS_DIR:\$PATH\""
if grep -qF "$CSCRIPTS_DIR" "$ZSHRC" 2>/dev/null; then
  echo "c-scripts PATH already exists in $ZSHRC, skipping"
else
  echo "$PATH_LINE" >> "$ZSHRC"
  echo "Added c-scripts to PATH in $ZSHRC"
fi

echo ""
echo "=== Configuring project root ==="
CONFIG_FILE="$SCRIPT_DIR/.config"
CURRENT_ROOT=""
if [ -f "$CONFIG_FILE" ] && grep -q "^PROJECT_ROOT_PATH=" "$CONFIG_FILE" 2>/dev/null; then
  CURRENT_ROOT=$(grep "^PROJECT_ROOT_PATH=" "$CONFIG_FILE" | cut -d'=' -f2-)
fi

if [ -n "$CURRENT_ROOT" ]; then
  read -rp "Project root path [$CURRENT_ROOT]: " PROJECT_ROOT
  PROJECT_ROOT="${PROJECT_ROOT:-$CURRENT_ROOT}"
else
  read -rp "Project root path (absolute path to KarmaSuite repo): " PROJECT_ROOT
fi

if [ -z "$PROJECT_ROOT" ]; then
  echo "Warning: No project root path provided. You can set it later in $CONFIG_FILE"
elif [ ! -d "$PROJECT_ROOT" ]; then
  echo "Warning: Directory '$PROJECT_ROOT' does not exist. Saving anyway."
fi

if [ -n "$PROJECT_ROOT" ]; then
  if [ -f "$CONFIG_FILE" ] && grep -q "^PROJECT_ROOT_PATH=" "$CONFIG_FILE" 2>/dev/null; then
    sed -i '' "s|^PROJECT_ROOT_PATH=.*|PROJECT_ROOT_PATH=$PROJECT_ROOT|" "$CONFIG_FILE"
  else
    echo "PROJECT_ROOT_PATH=$PROJECT_ROOT" >> "$CONFIG_FILE"
  fi
  echo "Saved PROJECT_ROOT_PATH=$PROJECT_ROOT to $CONFIG_FILE"
fi

echo ""
echo "=== Done ==="
echo "Run 'source ~/.zshrc' to apply changes."
echo ""
echo "Next steps:"
echo "  1. Get a Linear API key (with write permissions) from:"
echo "     https://linear.app/settings/api"
echo "     Then add it to $CSCRIPTS_DIR/.env:"
echo "     LINEAR_API_KEY=lin_api_your_key_here"
echo ""
echo "  2. Copy ks-rules.md to your KarmaSuite project:"
echo "     cp $SCRIPT_DIR/ks-rules.md /path/to/your/project/CLAUDE.md"
